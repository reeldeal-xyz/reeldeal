{
  "name": "eth-global-tokyo",
  "private": true,
  "workspaces": ["packages/*", "web"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test && bun run pipeline:test && cd contracts && forge test",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "abi": "bun scripts/export-abi.ts",
    "multibaas:setup": "bun scripts/multibaas-setup.ts",
    "dev": "bun run --filter web dev",
    "pipeline": "cd pipeline && uv run pipeline-serve",
    "pipeline:test": "cd pipeline && uv run pytest"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/bun": "latest"
  }
}
