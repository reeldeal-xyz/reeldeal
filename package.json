{
  "name": "eth-global-tokyo",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "frontend"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test && bun run pipeline:test && cd contracts && forge test",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "abi": "bun scripts/export-abi.ts",
    "species:gen": "bun packages/shared/scripts/gen-species.ts",
    "multibaas:setup": "bun scripts/multibaas-setup.ts",
    "dev": "bun run --filter web dev",
    "pipeline": "cd pipeline && uv run pipeline-serve",
    "pipeline:test": "cd pipeline && uv run pytest",
    "db:up": "DB_LOCAL=1 db/scripts/up.sh",
    "db:psql": "db/scripts/psql.sh",
    "db:test": "db/scripts/test.sh",
    "db:reset": "db/scripts/reset.sh",
    "db:down": "docker compose -f db/docker-compose.yml down",
    "keeper": "bun run --filter web keeper --",
    "db:migrate:geo": "bun db/scripts/migrate.ts",
    "db:migrate": "bun run db:migrate:geo && bun run --filter web db:migrate",
    "db:cross-check-plots": "bun run --filter web cross-check-plots",
    "dog:map": "bun scripts/dog-map.ts",
    "dog:query": "dotdog query --dag .doghouse/generated/repo.dag",
    "dog:trace": "dotdog trace --dag .doghouse/generated/repo.dag",
    "dog:test": "bun test scripts/dog-map.test.ts",
    "dog:check": "bun scripts/dog-check.ts",
    "dog:spec": "bun scripts/dog-check.ts spec",
    "dog:review": "bun scripts/dog-check.ts review",
    "dog:serve": "dotdog serve specs",
    "frontend:dev": "bun run --cwd frontend dev",
    "frontend:check": "bun run --cwd frontend check",
    "frontend:build": "bun run --cwd frontend build",
    "frontend:start": "bun run --cwd frontend start",
    "storybook": "bun run --cwd frontend storybook",
    "storybook:build": "bun run --cwd frontend build-storybook"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotdog": "0.9.0",
    "typescript": "^5.9.0"
  }
}
