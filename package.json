{
  "name": "eth-global-tokyo",
  "private": true,
  "workspaces": ["packages/*", "pipeline", "web"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test && cd contracts && forge test",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "abi": "bun scripts/export-abi.ts",
    "multibaas:setup": "bun scripts/multibaas-setup.ts",
    "dev": "bun run --filter web dev",
    "pipeline": "bun run --filter pipeline start",
    "keeper": "bun run --filter web keeper --",
    "dog:map": "bun scripts/dog-map.ts",
    "dog:query": "dotdog query --dag .doghouse/generated/repo.dag",
    "dog:trace": "dotdog trace --dag .doghouse/generated/repo.dag",
    "dog:test": "bun test scripts/dog-map.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotdog": "0.9.0",
    "typescript": "^5.9.0"
  }
}
