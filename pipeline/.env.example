# Copy to pipeline/.env on the server. Never commit .env.

# Public hostname Caddy gets a certificate for. With no domain, use the Elastic IP
# with dashes on sslip.io, e.g. 13-115-1-2.sslip.io. Unset = localhost.
SITE_ADDRESS=

# Copernicus Marine toolkit login (physics and waves).
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# S3 data lake (README §9). Credentials come from the EC2 instance role, not keys.
AWS_DEFAULT_REGION=ap-northeast-1
PIPELINE_S3_BUCKET=
