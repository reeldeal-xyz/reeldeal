# Copy to db/.env. Never commit .env. On the server, replace every password (scripts/gen-env.sh does it).
POSTGRES_DB=reeldeal
POSTGRES_PASSWORD=dev-postgres
DB_MIGRATOR_PASSWORD=dev-db-migrator
PIPELINE_PASSWORD=dev-pipeline
APP_MIGRATOR_PASSWORD=dev-app-migrator
APP_PASSWORD=dev-app
READONLY_PASSWORD=dev-readonly
DB_BACKUP_PASSWORD=dev-db-backup

# Host port for 127.0.0.1 access (admin, SSM port forwarding). Change if 5432 is taken locally.
DB_PORT=5432

# Server only. Data directory on the dedicated EBS volume, and where nightly dumps go.
# DB_DATA=/srv/pgdata/postgres
# DB_BACKUP_S3_URI=s3://eth-global-tokyo-pipeline/db
