---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PIPELINE_API_URL } from 'astro:env/server';
import { RULES } from '@repo/shared';
import { heatCoverage } from '@repo/shared';
import { readHeatRisk } from '../lib/heat-risk.server';
import { geoPath, geoPoint, geoGraticule, readHmiData } from '../lib/hmi.server';

const hmi = await readHmiData(PIPELINE_API_URL);
const lang = Astro.url.searchParams.get('lang') === 'ja' ? 'ja' : 'en';
const copy = lang === 'ja' ? {
  title: '養殖リスクマップ', subtitle: '宮城県沿岸の養殖区画と海況データ', species: '魚種', season: '年', layer: 'グラフのデータ', update: '更新', risks: 'リスク指標', heat: '海面水温', observed: '観測あり', unavailable: '利用不可', mode: '地図表示', twoD: '2D', no3d: '3D未対応', map: '養殖区画と海域', draw: '範囲を描く', cancel: '描画を終了', analyze: '範囲を解析', clear: '消去', help: '地図をクリックして3点以上を指定し、解析してください。', mapHelp: '＋／−で拡大・縮小。ドラッグで移動。', extent: '範囲は宮城県沿岸に限られます。', sampling: '衛星水温データを集計中…', source: 'データ出典', selected: '選択中の区画', observations: '観測値', references: '魚種別の基準値', countOnly: '観測日数。補償の判定には使用しません。', forecast: '予報・過去イベント', forecastUnavailable: '検証済みの予報データはありません。', noPlot: '区画データがありません', noPlotDetail: '区画データに接続できません。', noThreshold: 'この魚種の基準値は未登録です。', pipeline: 'データ接続中', notConfigured: '未設定', offline: '接続なし', noData: '有効な水温データはありません', noObservations: '検証済みの観測値がありません。', reset: '初期化', mapControls: '地図操作', pipelineMissing: 'データパイプラインが未設定です。',
} : {
  title: 'Aquaculture risk map', subtitle: 'Aquaculture plots and ocean conditions off Miyagi, Japan', species: 'Species', season: 'Year', layer: 'Chart data', update: 'Update', risks: 'Risk indicators', heat: 'Sea surface temperature', observed: 'Available', unavailable: 'Unavailable', mode: 'Map view', twoD: '2D', no3d: '3D unavailable', map: 'Plots and sea areas', draw: 'Draw area', cancel: 'Finish drawing', analyze: 'Analyze area', clear: 'Clear', help: 'Click the map to add 3 or more points, then analyze.', mapHelp: 'Use +/− to zoom; drag to pan.', extent: 'Area limited to the mapped Miyagi coast.', sampling: 'Sampling satellite temperature data…', source: 'Data source', selected: 'Selected plot', observations: 'Observations', references: 'Species thresholds', countOnly: 'Observed days only. Not a relief decision.', forecast: 'Forecast and event replay', forecastUnavailable: 'No validated forecast data available.', noPlot: 'No plot data', noPlotDetail: 'No connected plot data available.', noThreshold: 'No threshold registered for this species.', pipeline: 'Data connected', notConfigured: 'Not configured', offline: 'Offline', noData: 'No valid temperature data', noObservations: 'No validated observations to chart.', reset: 'Reset', mapControls: 'Map controls', pipelineMissing: 'Pipeline is not configured.',
};
const plotCode = Astro.url.searchParams.get('plot') ?? '';
const season = /^20\d{2}$/.test(Astro.url.searchParams.get('season') ?? '') ? Astro.url.searchParams.get('season')! : '2025';
const plot = hmi.status === 'available' ? hmi.plots.find((item) => item.plotCode === plotCode) ?? hmi.plots[0] : undefined;
const selectedSpecies = Astro.url.searchParams.get('species') ?? plot?.species[0] ?? '';
const supportedSpecies = plot?.species ?? [];
const species = supportedSpecies.includes(selectedSpecies) ? selectedSpecies : supportedSpecies[0] ?? '';
const risk = plot ? await readHeatRisk({ origin: PIPELINE_API_URL, plotCode: plot.plotCode, season }) : null;
const data = risk?.data ?? null;
const metric = Astro.url.searchParams.get('metric') === 'SST_ANOM' ? 'SST_ANOM'
  : Astro.url.searchParams.get('metric') === 'SST_MONTH' ? 'SST_MONTH' : 'SST';
const series = data?.indices.filter((item) => item.index === metric) ?? [];
const values = series.flatMap((item) => item.value === null ? [] : [item.value]);
const min = values.length ? Math.min(...values) : 0;
const max = values.length ? Math.max(...values) : 1;
const chartSegments: string[] = [];
let chartSegment: string[] = [];
series.forEach((item, index) => {
  if (item.value === null) {
    if (chartSegment.length > 1) chartSegments.push(chartSegment.join(' '));
    chartSegment = [];
    return;
  }
  chartSegment.push(`${(index / Math.max(series.length - 1, 1) * 760 + 20).toFixed(1)},${(180 - ((item.value - min) / Math.max(max - min, 0.1)) * 140).toFixed(1)}`);
});
if (chartSegment.length > 1) chartSegments.push(chartSegment.join(' '));
const coverage = data ? heatCoverage(data) : null;
const provenance = [...new Map(series.flatMap((item) => item.source ? [[item.source.sha256, item.source]] : [])).values()].slice(0, 4);
const heatRules = RULES.filter((rule) => rule.species === species && rule.peril === 'HEAT');
const sst = data?.indices.filter((item) => item.index === 'SST') ?? [];
const counts = heatRules.map((rule) => ({ rule, count: sst.filter((item) => item.value !== null
  && item.asOf.slice(5) >= (rule.window?.start ?? '07-01')
  && item.asOf.slice(5) <= (rule.window?.end ?? '09-30')
  && item.value >= (rule.tempC ?? Infinity)).length }));
const statusText = hmi.status === 'not-configured' ? copy.pipelineMissing
  : hmi.status === 'unavailable' ? (lang === 'ja' ? '区画・海域データを取得できません。' : 'Plot and sea-area data are unavailable.')
  : hmi.status === 'invalid-payload' ? (lang === 'ja' ? '地図データを読み取れません。' : 'Map data could not be read.') : '';
const riskText = !plot ? '' : risk?.status === 'not-configured' ? (lang === 'ja' ? '水温データは未設定です。' : 'Heat data is not configured.')
  : risk?.status === 'unimplemented' ? (lang === 'ja' ? '水温解析は未対応です。' : 'Heat analysis is not available.')
  : risk?.status === 'not-found' ? (lang === 'ja' ? `${plot.plotCode}の${season}年水温データはありません。` : `No heat data for ${plot.plotCode} in ${season}.`)
  : risk?.status === 'stale' ? (lang === 'ja' ? '対象期間の最新観測値がありません。' : 'Latest observations are not available for this period.')
  : risk?.status === 'partial' ? (lang === 'ja' ? '水温データに欠測があります。' : 'Some heat observations are missing.')
  : risk?.status === 'invalid-payload' ? (lang === 'ja' ? '水温データを読み取れません。' : 'Heat data could not be read.')
  : risk?.status === 'timeout' || risk?.status === 'unavailable' ? (lang === 'ja' ? '水温データに接続できません。' : 'Heat data is unavailable.') : '';
const plotSource = plot?.source === 'demo' ? 'Synthetic demo geometry · not a surveyed farm'
  : plot?.source === 'msil' ? 'MSIL plot geometry' : plot ? 'Uploaded plot geometry' : '';
const mapGrid = geoGraticule();
const languageUrl = (locale: string) => { const params = new URLSearchParams(Astro.url.searchParams); params.set('lang', locale); return `/hmi?${params}`; };
const speciesName = (value: string) => lang === 'ja' ? ({ nori: 'ノリ', wakame: 'ワカメ', kombu: 'コンブ', scallop: 'ホタテ', oyster: 'カキ', hoya: 'ホヤ', yellowtail: 'ブリ', sea_bream: 'マダイ', coho_salmon: 'ギンザケ', bluefin_tuna: 'クロマグロ' }[value] ?? value) : value.replaceAll('_', ' ');
const metricName = metric === 'SST_ANOM' ? (lang === 'ja' ? '水温偏差' : 'SST anomaly') : metric === 'SST_MONTH' ? (lang === 'ja' ? '月平均水温' : 'Monthly SST') : (lang === 'ja' ? '海面水温' : 'Sea surface temperature');
---
<BaseLayout title={copy.title} description={copy.subtitle} section="hmi" lang={lang}>
  <div class="hmi-page" data-copy={JSON.stringify(copy)} data-season={season} data-lang={lang}>
    <header class="hmi-heading">
      <div><h1>{copy.title}</h1><p>{copy.subtitle}</p></div>
      <div class="heading-tools"><nav class="language" aria-label="Language"><a href={languageUrl('en')} aria-current={lang === 'en' ? 'page' : undefined}>EN</a><a href={languageUrl('ja')} lang="ja" aria-current={lang === 'ja' ? 'page' : undefined}>日本語</a></nav><span class:list={['live-badge', hmi.status !== 'available' && 'offline']}><i></i>{hmi.status === 'available' ? copy.pipeline : hmi.status === 'not-configured' ? copy.notConfigured : copy.offline}</span></div>
    </header>
    <div class="hmi-workspace">
      <aside class="hmi-rail" aria-label={lang === 'ja' ? '地図とリスク条件' : 'Map and risk controls'}>
        <form method="get" class="controls">
          <input type="hidden" name="lang" value={lang} />
          {plot && <input type="hidden" name="plot" value={plot.plotCode} />}
          <label>{copy.species}
            <select name="species" disabled={!supportedSpecies.length}>
              {supportedSpecies.map((item) => <option value={item} selected={item === species}>{speciesName(item)}</option>)}
            </select>
          </label>
          <label>{copy.season}
            <select name="season">
              {[2025, 2024, 2023, 2022].map((year) => <option value={year} selected={String(year) === season}>{year}</option>)}
            </select>
          </label>
          <label>{copy.layer}
            <select name="metric">
              <option value="SST" selected={metric === 'SST'}>{lang === 'ja' ? '海面水温' : 'Sea surface temperature'}</option>
              <option value="SST_ANOM" selected={metric === 'SST_ANOM'}>{lang === 'ja' ? '水温偏差' : 'SST anomaly'}</option>
              <option value="SST_MONTH" selected={metric === 'SST_MONTH'}>{lang === 'ja' ? '月平均水温' : 'Monthly SST'}</option>
            </select>
          </label>
          <button type="submit">{copy.update}</button>
        </form>
      </aside>
      <section class="map-panel" aria-labelledby="map-title">
        <div class="panel-heading"><div><h2 id="map-title">{copy.map}</h2></div><span class="map-scale">38.85°N · 141.8°E</span></div>
        {statusText && <p class="notice" role="status">{statusText}</p>}
        <div class="map-wrap">
          <div class="map-controls" aria-label={copy.mapControls}>
            <div><button type="button" data-map-zoom="in" aria-label={lang === 'ja' ? '拡大' : 'Zoom in'}>+</button><button type="button" data-map-zoom="out" aria-label={lang === 'ja' ? '縮小' : 'Zoom out'}>−</button><button type="button" data-map-zoom="reset">{copy.reset}</button></div>
            <output data-map-scale aria-live="polite">100%</output>
          </div>
          <div class="area-controls"><button type="button" data-area-draw aria-pressed="false">{copy.draw}</button><button type="button" data-area-run disabled>{copy.analyze}</button><button type="button" data-area-clear disabled>{copy.clear}</button></div>
          <svg id="hmi-map" class="map" viewBox="0 0 800 620" role="application" aria-label={lang === 'ja' ? '宮城県の養殖区画図。クリックして範囲を指定できます。' : 'Miyagi plot map. Click to draw a polygon area.'} tabindex="0">
            <rect width="800" height="620" fill="#cbe9e8" />
            <g class="map-features">
              <rect x={mapGrid.bounds.x} y={mapGrid.bounds.y} width={mapGrid.bounds.width} height={mapGrid.bounds.height} class="map-extent" />
              <g class="graticule">
                {mapGrid.longitudes.map((line) => <><path d={line.d} /><text x={line.x} y={line.y}>{line.label}</text></>)}
                {mapGrid.latitudes.map((line) => <><path d={line.d} /><text x={line.x} y={line.y}>{line.label}</text></>)}
              </g>
              {hmi.status === 'available' && hmi.zones.map((zone) => zone.geometry && <path d={geoPath(zone.geometry)} class="zone" fill-rule="evenodd"><title>{zone.nameJa ?? zone.name} · approximate monitoring zone</title></path>)}
              {hmi.status === 'available' && hmi.plots.map((item) => { const [x,y] = geoPoint(item.centroid); const href = `/hmi?lang=${lang}&plot=${encodeURIComponent(item.plotCode)}&season=${season}&species=${encodeURIComponent(species)}&metric=${metric}`; const selected = item.plotCode === plot?.plotCode; const longitude = item.centroid[0].toFixed(4); const latitude = item.centroid[1].toFixed(4); return <g class={item.source === 'demo' ? 'farm demo' : 'farm'}><path d={geoPath(item.geometry)} class="farm-area"><title>{item.plotCode} · {item.source === 'demo' ? (lang === 'ja' ? 'デモ用' : 'demo') : item.source}</title></path><a href={href} aria-label={lang === 'ja' ? `${item.plotCode}を選択。北緯${latitude}度、東経${longitude}度` : `Select plot ${item.plotCode} at ${latitude}°N, ${longitude}°E`}><circle cx={x} cy={y} r={selected ? 9 : 6} data-marker-radius={selected ? 9 : 6} class="plot"><title>{item.plotCode} · {latitude}°N, {longitude}°E</title></circle></a></g>; })}
            </g>
          </svg>
          {!statusText && hmi.status === 'available' && !hmi.plots.length && <p class="empty-map">{lang === 'ja' ? '表示範囲内に区画がありません。' : 'No plots in this map extent.'}</p>}
        </div>
        <p class="map-help">{copy.mapHelp}</p>
        <p class="map-help" data-area-help aria-live="polite">{copy.help} {copy.extent}</p>
        <section class="area-result" data-area-result aria-live="polite" hidden></section>
        <div class="map-legend"><span><i class="legend-plot"></i>{lang === 'ja' ? '養殖区画' : 'Farm plot'}</span><span><i class="legend-demo"></i>{lang === 'ja' ? 'デモ区画' : 'Demo plot'}</span><span><i class="legend-zone"></i>{lang === 'ja' ? '概略海域' : 'Approximate sea area'}</span></div>
        {plot && <p class="source-note">{lang === 'ja' ? '選択中' : 'Selected'} {plot.plotCode} · {plot.centroid[1].toFixed(4)}°N, {plot.centroid[0].toFixed(4)}°E · {lang === 'ja' ? (plot.source === 'demo' ? 'デモ用形状' : plot.source === 'msil' ? 'MSIL区画' : '登録区画') : plotSource}{plot.prefecture ? ` · ${plot.prefecture}` : ''}{plot.seaArea ? ` · ${plot.seaArea}` : ''}</p>}
      </section>
      <aside class="detail-rail" aria-label={lang === 'ja' ? '選択区画の観測値' : 'Selected plot observations'}>
        <section class="detail-card">
          <p class="eyebrow">{copy.selected}</p>
          {plot ? <><h2>{plot.plotCode}</h2><p>{plot.species.map(speciesName).join(' · ')}</p><p class="source-note">{lang === 'ja' ? (plot.source === 'demo' ? 'デモ用区画' : plot.source === 'msil' ? 'MSIL区画' : '登録区画') : plotSource}</p></> : <><h2>{copy.noPlot}</h2><p>{copy.noPlotDetail}</p></>}
        </section>
        <section class="detail-card">
          <div class="section-title"><div><p class="eyebrow">{copy.observations} · {season}</p><h2>{metricName}</h2></div><span class="unit">°C</span></div>
          {data && values.length > 1 ? <svg class="chart" viewBox="0 0 800 210" role="img" aria-label={`${metric} ${lang === 'ja' ? '観測時系列' : 'observed time series'} ${plot?.plotCode}`}><path class="chart-grid" d="M20 40H780M20 110H780M20 180H780"/>{chartSegments.map((points) => <polyline points={points} />)}<text x="20" y="202">{series[0]?.asOf}</text><text x="690" y="202">{series.at(-1)?.asOf}</text></svg> : <p class="empty-chart">{riskText || copy.noObservations}</p>}
          {coverage && <p class="coverage">{lang === 'ja' ? `観測 ${coverage.observedDays}日 · 欠測 ${coverage.nullDays + coverage.omittedDays}日` : `${coverage.observedDays} observed days · ${coverage.nullDays + coverage.omittedDays} missing`}</p>}
          {!!provenance.length && <p class="coverage">{lang === 'ja' ? 'データ製品: ' : 'Products: '}{provenance.map((source) => `${source.product} · ${source.sha256.slice(0, 12)}`).join(' / ')}</p>}
        </section>
        <section class="detail-card">
          <p class="eyebrow">{copy.references}</p><h2>{species ? speciesName(species) : copy.species}</h2>
          {counts.length ? counts.map(({ rule, count }) => <div class="threshold"><div><strong>{lang === 'ja' ? `段階 ${rule.tier}` : `Tier ${rule.tier}`}</strong><span>{rule.tempC}°C · {rule.window?.start} – {rule.window?.end}</span></div><b>{count}/{rule.threshold}{lang === 'ja' ? '日' : ' days'}</b></div>) : <p>{copy.noThreshold}</p>}
          <p class="layer-note">{copy.countOnly}</p>
        </section>
      </aside>
    </div>
    <footer class="hmi-foot">{copy.source}: {lang === 'ja' ? '衛星観測データ。区画の一部はデモ用です。' : 'Satellite observations. Some plot geometries are for demonstration.'}</footer>
  </div>
</BaseLayout>
<script>
  const hmiPage = document.querySelector<HTMLElement>('.hmi-page');
  const uiCopy = JSON.parse(hmiPage?.dataset.copy ?? '{}') as Record<string, string>;
  const season = hmiPage?.dataset.season ?? '2025';
  const lang = hmiPage?.dataset.lang ?? 'en';
  const svg = document.querySelector<SVGSVGElement>('#hmi-map');
  const zoomReadout = document.querySelector<HTMLOutputElement>('[data-map-scale]');
  if (svg && zoomReadout) {
    const initial = { x: 0, y: 0, width: 800, height: 620 };
    let view = { ...initial };
    let drag: { pointerId: number; clientX: number; clientY: number; view: typeof initial; moved: boolean } | null = null;
    let suppressClick = false;
    const drawButton = document.querySelector<HTMLButtonElement>('[data-area-draw]');
    const runButton = document.querySelector<HTMLButtonElement>('[data-area-run]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-area-clear]');
    const areaHelp = document.querySelector<HTMLElement>('[data-area-help]');
    const areaResult = document.querySelector<HTMLElement>('[data-area-result]');
    const mapFeatures = svg.querySelector<SVGGElement>('.map-features');
    let drawing = false;
    let coordinates: [number, number][] = [];
    let sketch: SVGPolygonElement | null = null;
    const mapPosition = (event: PointerEvent | MouseEvent): [number, number] => {
      const point = svg.createSVGPoint(); point.x = event.clientX; point.y = event.clientY;
      const position = point.matrixTransform(svg.getScreenCTM()!.inverse());
      return [position.x, position.y];
    };
    const projectCoordinate = ([longitude, latitude]: [number, number]) => {
      const scale = Math.cos(38.85 * Math.PI / 180);
      const units = Math.min(744 / (2.6 * scale), 564 / 3.3);
      return [(800 - 2.6 * scale * units) / 2 + (longitude - 140.5) * scale * units,
        (620 - 3.3 * units) / 2 + (40.5 - latitude) * units];
    };
    const mapCoordinate = (event: PointerEvent | MouseEvent) => {
      const [x, y] = mapPosition(event);
      const scale = Math.cos(38.85 * Math.PI / 180);
      const units = Math.min(744 / (2.6 * scale), 564 / 3.3);
      const left = (800 - 2.6 * scale * units) / 2;
      const top = (620 - 3.3 * units) / 2;
      return [140.5 + (x - left) / (scale * units), 40.5 - (y - top) / units] as [number, number];
    };
    const refreshSketch = () => {
      if (!mapFeatures) return;
      sketch?.remove();
      if (coordinates.length) {
        const points = coordinates.map((coordinate) => {
          const longitude = Math.max(140.5, Math.min(143.1, coordinate[0]));
          const latitude = Math.max(37.2, Math.min(40.5, coordinate[1]));
          return projectCoordinate([longitude, latitude]).join(',');
        }).join(' ');
        sketch = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        sketch.setAttribute('points', points); sketch.setAttribute('class', 'area-sketch');
        mapFeatures.append(sketch);
      }
      if (runButton) runButton.disabled = coordinates.length < 3;
      if (clearButton) clearButton.disabled = coordinates.length === 0 && !drawing;
    };
    drawButton?.addEventListener('click', () => {
      drawing = !drawing;
      if (!drawing) { svg.classList.remove('drawing'); drawButton.textContent = uiCopy.draw; drawButton.setAttribute('aria-pressed', 'false'); refreshSketch(); return; }
      coordinates = []; areaResult?.setAttribute('hidden', ''); refreshSketch();
      svg.classList.add('drawing'); svg.focus();
      drawButton.textContent = uiCopy.cancel; drawButton.setAttribute('aria-pressed', 'true');
      if (areaHelp) areaHelp.textContent = `${uiCopy.help} ${uiCopy.extent}`;
    });
    clearButton?.addEventListener('click', () => {
      drawing = false; coordinates = []; sketch?.remove(); sketch = null;
      svg.classList.remove('drawing');
      if (drawButton) { drawButton.textContent = uiCopy.draw; drawButton.setAttribute('aria-pressed', 'false'); }
      refreshSketch();
      if (areaHelp) areaHelp.textContent = `${uiCopy.help} ${uiCopy.extent}`;
      if (areaResult) { areaResult.hidden = true; areaResult.textContent = ''; }
    });
    svg.addEventListener('click', (event) => {
      if (!drawing || suppressClick || (event.target instanceof Element && event.target.closest('a'))) return;
      event.preventDefault(); coordinates.push(mapCoordinate(event)); refreshSketch();
    });
    runButton?.addEventListener('click', async () => {
      if (coordinates.length < 3 || !areaResult) return;
      drawing = false; svg.classList.remove('drawing');
      if (drawButton) { drawButton.textContent = uiCopy.draw; drawButton.setAttribute('aria-pressed', 'false'); }
      const ring = [...coordinates, coordinates[0]];
      areaResult.hidden = false; areaResult.textContent = uiCopy.sampling;
      runButton.disabled = true;
      try {
        const response = await fetch('/api/risk/heat/area', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ feature: { type: 'Feature', properties: null, geometry: { type: 'Polygon', coordinates: [ring] } }, start: `${season}-06-01`, end: `${season}-10-31` }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Area analysis unavailable.');
        const observed = result.indices.filter((item: { index: string; value: number | null }) => item.index === 'SST' && item.value !== null);
        const mean = observed.length ? observed.reduce((sum: number, item: { value: number }) => sum + item.value, 0) / observed.length : null;
        areaResult.textContent = lang === 'ja'
          ? `${(result.plot.areaM2 / 1_000_000).toFixed(2)} km² · 水温観測 ${observed.length}日 · ${mean === null ? uiCopy.noData : `平均水温 ${mean.toFixed(1)}°C`} · ${result.plot.seaArea ?? '海域未分類'}`
          : `${(result.plot.areaM2 / 1_000_000).toFixed(2)} km² · ${observed.length} observed SST days · ${mean === null ? uiCopy.noData : `mean SST ${mean.toFixed(1)} °C`} · ${result.plot.seaArea ?? 'unclassified sea area'}`;
      } catch (error) {
        areaResult.textContent = lang === 'ja' ? '範囲を解析できませんでした。' : error instanceof Error ? error.message : 'Area analysis unavailable.';
      } finally { runButton.disabled = coordinates.length < 3; }
    });
    const clamp = (value: number, low: number, high: number) => Math.max(low, Math.min(high, value));
    const update = () => {
      svg.setAttribute('viewBox', `${view.x} ${view.y} ${view.width} ${view.height}`);
      const scale = initial.width / view.width;
      svg.querySelectorAll<SVGCircleElement>('[data-marker-radius]').forEach((marker) => {
        marker.setAttribute('r', String(Number(marker.dataset.markerRadius) / scale));
      });
      zoomReadout.value = `${Math.round(scale * 100)}%`;
    };
    const zoomAt = (nextScale: number, x = view.x + view.width / 2, y = view.y + view.height / 2) => {
      const scale = clamp(nextScale, 1, 8);
      const width = initial.width / scale;
      const height = initial.height / scale;
