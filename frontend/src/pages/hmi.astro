---
import BaseLayout from '../layouts/BaseLayout.astro';
import HmiObservations from '../components/organisms/HmiObservations.astro';
import 'leaflet/dist/leaflet.css';
import '../styles/hmi.css';
import { PIPELINE_API_URL } from 'astro:env/server';
import { heatDays } from '@repo/shared';
import { readHeatRisk } from '../lib/heat-risk.server';
import { readSpecies } from '../lib/species.server';
import { readHmiData } from '../lib/hmi.server';
import { HAB_MONTHS, habMonth, scaleGradient } from '../lib/hab-layers';
import { readHabLayer } from '../lib/hab-layers.server';

const hmi = await readHmiData(PIPELINE_API_URL);
const lang = Astro.url.searchParams.get('lang') === 'ja' ? 'ja' : 'en';
const copy = lang === 'ja' ? {
  title: '養殖リスクマップ',
  subtitle: '宮城県沿岸の養殖区画と海況データ',
  plot: '養殖区画',
  species: '魚種',
  season: 'データ年',
  layer: '観測項目',
  update: '表示を更新',
  map: '養殖区画と海域',
  draw: '範囲を描く',
  cancel: '描画を終了',
  analyze: '範囲を解析',
  clear: '消去',
  help: '地図をクリックして3点以上を指定し、解析してください。',
  mapHelp: '＋／−で拡大・縮小。ドラッグで移動。',
  extent: '範囲は宮城県沿岸に限られます。',
  sampling: '衛星水温データを集計中…',
  source: 'データ出典',
  selected: '選択中の区画',
  references: '魚種別の基準値',
  countOnly: '観測日数のみ。補償判定そのものではありません。',
  noPlot: '区画データがありません',
  noPlotDetail: '区画データに接続できません。',
  noThreshold: 'この魚種の基準値は未登録です。',
  pipeline: 'データ接続中',
  notConfigured: '未設定',
  offline: '接続なし',
  noData: '有効な水温データはありません',
  noObservations: '検証済みの観測値がありません。',
  reset: '選択区画へ',
  mapControls: '地図操作',
  pipelineMissing: 'データパイプラインが未設定です。',
  imageryContext: '地図画像は参考表示です。区画別の検証済み観測値とは別データです。',
} : {
  title: 'Aquaculture risk map',
  subtitle: 'Aquaculture plots and ocean conditions off Miyagi, Japan',
  plot: 'Farm plot',
  species: 'Species',
  season: 'Data year',
  layer: 'Observation',
  update: 'Update view',
  map: 'Plots and sea areas',
  draw: 'Draw area',
  cancel: 'Finish drawing',
  analyze: 'Analyze area',
  clear: 'Clear',
  help: 'Click the map to add 3 or more points, then analyze.',
  mapHelp: 'Use +/− to zoom; drag to pan.',
  extent: 'Area limited to the mapped Miyagi coast.',
  sampling: 'Sampling satellite temperature data…',
  source: 'Data source',
  selected: 'Selected plot',
  references: 'Species thresholds',
  countOnly: 'Observed days only. This is not itself a relief decision.',
  noPlot: 'No plot data',
  noPlotDetail: 'No connected plot data available.',
  noThreshold: 'No threshold registered for this species.',
  pipeline: 'Data connected',
  notConfigured: 'Not configured',
  offline: 'Offline',
  noData: 'No valid temperature data',
  noObservations: 'No validated observations to chart.',
  reset: 'Reset to plot',
  mapControls: 'Map controls',
  pipelineMissing: 'Pipeline is not configured.',
  imageryContext: 'Map imagery is visual context, separate from validated plot observations.',
};

const plotCode = Astro.url.searchParams.get('plot') ?? '';
const season = /^20\d{2}$/.test(Astro.url.searchParams.get('season') ?? '') ? Astro.url.searchParams.get('season')! : '2025';
const plot = hmi.status === 'available'
  ? hmi.plots.find((item) => item.plotCode === plotCode) ?? hmi.plots[0]
  : undefined;
const selectedSpecies = Astro.url.searchParams.get('species') ?? plot?.species[0] ?? '';
const supportedSpecies = plot?.species ?? [];
const species = supportedSpecies.includes(selectedSpecies) ? selectedSpecies : supportedSpecies[0] ?? '';
const month = habMonth(Astro.url.searchParams.get('habMonth'));
const [risk, hab] = await Promise.all([
  plot ? readHeatRisk({ origin: PIPELINE_API_URL, plotCode: plot.plotCode, season }) : Promise.resolve(null),
  readHabLayer(PIPELINE_API_URL, season, month),
]);
const habLayer = hab.layer;
const habText = hab.status === 'not-built' ? (lang === 'ja' ? `${season}年${Number(month)}月のクロロフィルaレイヤーは未作成です。` : `No chlorophyll-a layer built for ${season}-${month}.`)
  : hab.status === 'unavailable' || hab.status === 'invalid-payload' ? (lang === 'ja' ? 'クロロフィルaレイヤーに接続できません。' : 'Chlorophyll-a layer is unavailable.') : '';
const habOverlay = habLayer ? JSON.stringify({
  url: `/api/tiles${habLayer.tileUrl}`,
  bounds: [[habLayer.bbox[1], habLayer.bbox[0]], [habLayer.bbox[3], habLayer.bbox[2]]],
}) : '';
const data = risk?.data ?? null;
const metric = Astro.url.searchParams.get('metric') === 'SST_ANOM' ? 'SST_ANOM'
  : Astro.url.searchParams.get('metric') === 'SST_MONTH' ? 'SST_MONTH' : 'SST';
const [risk, speciesInfo] = await Promise.all([
  plot ? readHeatRisk({ origin: PIPELINE_API_URL, plotCode: plot.plotCode, season }) : null,
  species ? readSpecies({ origin: PIPELINE_API_URL, species }) : null,
]);
const data = risk?.data ?? null;
const speciesData = speciesInfo?.data ?? null;
const seasons = [...new Set([Number(season), 2026, 2025, 2024, 2023, 2022])].sort((a, b) => b - a);

const heatRules = speciesData?.rules.filter((rule) => rule.peril === 'HEAT') ?? [];
const sst = (data?.indices.filter((item) => item.index === 'SST') ?? []).map((item) => ({ date: item.asOf, value: item.value }));
const counts = heatRules.map((rule) => ({
  rule,
  count: rule.tempC !== null && rule.window ? heatDays(sst, rule.tempC, rule.window).at(-1)?.value ?? 0 : 0,
}));
const speciesText = !species || speciesInfo?.status === 'available' ? ''
  : speciesInfo?.status === 'not-configured'
    ? (lang === 'ja' ? '魚種の基準データは未設定です。' : 'Species reference data is not configured.')
  : speciesInfo?.status === 'not-found'
    ? (lang === 'ja' ? `${species} の魚種基準データがありません。` : `No species reference for ${species}.`)
  : speciesInfo?.status === 'invalid-payload'
    ? (lang === 'ja' ? '魚種の基準データを検証できませんでした。' : 'Species reference data failed validation.')
  : (lang === 'ja' ? '魚種の基準データに接続できません。' : 'Species reference data is unavailable.');

const statusText = hmi.status === 'not-configured'
  ? copy.pipelineMissing
  : hmi.status === 'unavailable'
    ? (lang === 'ja' ? '区画・海域データを取得できません。' : 'Plot and sea-area data are unavailable.')
    : hmi.status === 'invalid-payload'
      ? (lang === 'ja' ? '地図データを読み取れません。' : 'Map data could not be read.')
      : '';

const riskText = !plot ? ''
  : risk?.status === 'not-configured' ? (lang === 'ja' ? '水温データは未設定です。' : 'Heat data is not configured.')
  : risk?.status === 'unimplemented' ? (lang === 'ja' ? '水温解析は未対応です。' : 'Heat analysis is not available.')
  : risk?.status === 'not-found' ? (lang === 'ja' ? `${plot.plotCode}の${season}年水温データはありません。` : `No heat data for ${plot.plotCode} in ${season}.`)
  : risk?.status === 'stale' ? (lang === 'ja' ? '対象期間の最新観測値がありません。' : 'Latest observations are not available for this period.')
  : risk?.status === 'partial' ? (lang === 'ja' ? '水温データに欠測があります。' : 'Some heat observations are missing.')
  : risk?.status === 'invalid-payload' ? (lang === 'ja' ? '水温データを読み取れません。' : 'Heat data could not be read.')
  : risk?.status === 'timeout' || risk?.status === 'unavailable'
    ? (lang === 'ja' ? '水温データに接続できません。' : 'Heat data is unavailable.')
    : '';

const plotSource = plot?.source === 'demo'
  ? (lang === 'ja' ? 'デモ用形状 · 実測区画ではありません' : 'Synthetic demo geometry · not a surveyed farm')
  : plot?.source === 'msil'
    ? (lang === 'ja' ? 'MSIL区画形状' : 'MSIL plot geometry')
    : plot ? (lang === 'ja' ? '登録区画形状' : 'Uploaded plot geometry') : '';

const mapFeatures = JSON.stringify({
  plots: hmi.status === 'available' ? hmi.plots.map((item) => ({
    plotCode: item.plotCode,
    centroid: item.centroid,
    geometry: item.geometry,
    source: item.source,
    selected: item.plotCode === plot?.plotCode,
  })) : [],
  zones: hmi.status === 'available' ? hmi.zones.filter((zone) => zone.geometry).map((zone) => ({
    geometry: zone.geometry,
    name: lang === 'ja' ? zone.nameJa ?? zone.name : zone.name,
  })) : [],
});

const languageUrl = (locale: string) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('lang', locale);
  return `/hmi?${params}`;
};
const speciesName = (value: string) => lang === 'ja'
  ? ({ nori: 'ノリ', wakame: 'ワカメ', kombu: 'コンブ', scallop: 'ホタテ', oyster: 'カキ', hoya: 'ホヤ', yellowtail: 'ブリ', sea_bream: 'マダイ', coho_salmon: 'ギンザケ', bluefin_tuna: 'クロマグロ' }[value] ?? value)
  : value.replaceAll('_', ' ');
const metricName = metric === 'SST_ANOM'
  ? (lang === 'ja' ? '水温偏差' : 'SST anomaly')
  : metric === 'SST_MONTH'
    ? (lang === 'ja' ? '月平均水温' : 'Monthly SST')
    : (lang === 'ja' ? '海面水温' : 'Sea surface temperature');
---

<BaseLayout title={copy.title} description={copy.subtitle} section="hmi" lang={lang}>
  <div class="hmi-page" data-copy={JSON.stringify(copy)} data-season={season} data-lang={lang} data-map-features={mapFeatures} data-hab-overlay={habOverlay}>
    <header class="hmi-heading">
      <div>
        <h1>{copy.title}</h1>
        <p>{copy.subtitle}</p>
      </div>
      <div class="heading-tools">
        <nav class="language" aria-label={lang === 'ja' ? '言語' : 'Language'}>
          <a href={languageUrl('en')} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          <a href={languageUrl('ja')} lang="ja" aria-current={lang === 'ja' ? 'page' : undefined}>日本語</a>
        </nav>
        <span class:list={['live-badge', hmi.status !== 'available' && 'offline']}>
          <i aria-hidden="true"></i>
          {hmi.status === 'available' ? copy.pipeline : hmi.status === 'not-configured' ? copy.notConfigured : copy.offline}
        </span>
      </div>
    </header>

    <div class="hmi-workspace">
      <aside class="hmi-rail" aria-label={lang === 'ja' ? '地図と観測条件' : 'Map and observation controls'}>
        <form method="get" class="controls">
          <input type="hidden" name="lang" value={lang} />

          <label>{copy.plot}
            <select name="plot" disabled={hmi.status !== 'available' || !hmi.plots.length}>
              {hmi.status === 'available' && hmi.plots.length
                ? hmi.plots.map((item) => <option value={item.plotCode} selected={item.plotCode === plot?.plotCode}>
                    {item.plotCode}{item.source === 'demo' ? (lang === 'ja' ? ' · デモ' : ' · demo') : ''}
                  </option>)
                : <option>{copy.noPlot}</option>}
            </select>
          </label>

          <label>{copy.species}
            <select name="species" disabled={!supportedSpecies.length}>
              {supportedSpecies.length
                ? supportedSpecies.map((item) => <option value={item} selected={item === species}>{speciesName(item)}</option>)
                : <option>—</option>}
            </select>
          </label>

          <label>{copy.season}
            <select name="season">
              {seasons.map((year) => <option value={year} selected={String(year) === season}>{year}</option>)}
            </select>
          </label>

          <label>{copy.layer}
            <select name="metric">
              <option value="SST" selected={metric === 'SST'}>{lang === 'ja' ? '海面水温' : 'Sea surface temperature'}</option>
              <option value="SST_ANOM" selected={metric === 'SST_ANOM'}>{lang === 'ja' ? '水温偏差' : 'SST anomaly'}</option>
              <option value="SST_MONTH" selected={metric === 'SST_MONTH'}>{lang === 'ja' ? '月平均水温' : 'Monthly SST'}</option>
            </select>
          </label>
          <label>{lang === 'ja' ? 'HAB指標（クロロフィルa）の月' : 'HAB chl-a month'}
            <select name="habMonth">
              {HAB_MONTHS.map((value) => <option value={value} selected={value === month}>{lang === 'ja' ? `${Number(value)}月` : new Date(Date.UTC(2000, Number(value) - 1, 1)).toLocaleString('en', { month: 'long', timeZone: 'UTC' })}</option>)}
            </select>
          </label>

          <button type="submit">{copy.update}</button>
        </form>
      </aside>

      <section class="map-panel" aria-labelledby="map-title">
        <div class="panel-heading">
          <h2 id="map-title">{copy.map}</h2>
          <output class="map-scale" data-map-center aria-live="polite">38.85°N · 141.80°E</output>
        </div>

        {statusText && <p class="notice" role="status">{statusText}</p>}

        <div class="map-toolbar">
          <nav class="map-layers" aria-label={lang === 'ja' ? '衛星データレイヤー' : 'Satellite data layers'}>
            <button type="button" data-map-layer="satellite" aria-pressed="true">{lang === 'ja' ? '衛星写真' : 'Satellite'}</button>
            <button type="button" data-map-layer="sst" aria-pressed="false">SST</button>
            <button type="button" data-map-layer="anom" aria-pressed="false">{lang === 'ja' ? '水温偏差' : 'SST anomaly'}</button>
            <button type="button" data-map-layer="chl" aria-pressed="false">{lang === 'ja' ? 'クロロフィルa' : 'Chlorophyll-a'}</button>
            <button type="button" data-map-layer="hab" aria-pressed="false" disabled={!habLayer} title={habText || undefined}>{lang === 'ja' ? 'HAB（JAXA）' : 'HAB chl-a (JAXA)'}</button>
          </nav>

          <div class="map-controls" role="group" aria-label={copy.mapControls}>
            <div>
              <button type="button" data-map-zoom="in" aria-label={lang === 'ja' ? '拡大' : 'Zoom in'}>+</button>
              <button type="button" data-map-zoom="out" aria-label={lang === 'ja' ? '縮小' : 'Zoom out'}>−</button>
              <button type="button" data-map-zoom="reset">{copy.reset}</button>
            </div>
          </div>
        </div>

        <p class="map-layer-note" data-map-layer-note>{lang === 'ja' ? '衛星画像のみ · Esri World Imagery' : 'Imagery only · Esri World Imagery'}</p>

        <div class="map-wrap">
          <div
            id="hmi-map"
            class="map"
            role="application"
            aria-label={lang === 'ja' ? '宮城県の養殖区画図。ドラッグで移動できます。' : 'Miyagi plot map. Drag to pan the map.'}
            tabindex="0"
          ></div>
          {!statusText && hmi.status === 'available' && !hmi.plots.length && <p class="empty-map">
            {lang === 'ja' ? '表示範囲内に区画がありません。' : 'No plots in this map extent.'}
          </p>}
        </div>

        <p class="map-attribution">
          {lang === 'ja' ? '背景地図' : 'Basemap'}: Esri, Maxar, Earthstar Geographics, GIS User Community
          · {lang === 'ja' ? '衛星レイヤー' : 'overlays'}: NASA GIBS / GHRSST MUR / PACE OCI
        </p>

        <p class="map-tile-status" data-map-tile-status role="status" hidden>
          <span>{lang === 'ja' ? '地図タイルを読み込めませんでした。区画と観測データは引き続き利用できます。' : 'Map tiles failed to load. Plot and observation data remain available.'}</span>
          <button type="button" data-map-tiles-retry>{lang === 'ja' ? '再試行' : 'Retry'}</button>
        </p>

        <div class="area-controls" role="group" aria-label={lang === 'ja' ? '範囲解析' : 'Area analysis'}>
          <button type="button" data-area-draw aria-pressed="false">{copy.draw}</button>
          <button type="button" data-area-run disabled>{copy.analyze}</button>
          <button type="button" data-area-clear disabled>{copy.clear}</button>
        </div>

        <p class="map-help">{copy.mapHelp}</p>
        <p class="map-help">{copy.imageryContext}</p>
        <p class="map-help" data-area-help aria-live="polite">{copy.help} {copy.extent}</p>
        <section class="area-result" data-area-result aria-live="polite" hidden></section>
        {habLayer?.tileScale && <section class="hab-legend" data-hab-legend hidden aria-label={lang === 'ja' ? 'クロロフィルa凡例' : 'Chlorophyll-a legend'}>
          <p class="hab-legend-title"><strong>{lang === 'ja' ? 'クロロフィルa（JAXA GCOM-C SGLI）' : 'Chlorophyll-a (JAXA GCOM-C SGLI)'}</strong> · {habLayer.cadence === 'monthly' ? (lang === 'ja' ? `${habLayer.date.slice(0, 7)} 月合成` : `${habLayer.date.slice(0, 7)} monthly composite`) : habLayer.date}</p>
          <div class="hab-ramp" style={`background: ${scaleGradient(habLayer.tileScale.colors)}`}></div>
          <p class="hab-ramp-labels"><span>≤{habLayer.tileScale.min}</span><span>{Math.round(Math.sqrt(habLayer.tileScale.min * habLayer.tileScale.max) * 10) / 10}</span><span>≥{habLayer.tileScale.max} {habLayer.tileScale.unit}{habLayer.tileScale.kind === 'log' ? (lang === 'ja' ? '（対数）' : ' (log)') : ''}</span></p>
          <p class="coverage">{lang === 'ja' ? `有効画素 ${(habLayer.validFraction * 100).toFixed(0)}% · 透明部は雲・陸・欠測` : `${(habLayer.validFraction * 100).toFixed(0)}% valid cells · transparent = cloud, land or no data`} · {habLayer.product} · {habLayer.sha256.slice(0, 12)}</p>
          <p class="coverage">{lang === 'ja' ? 'クロロフィルaは藻類量の指標で、貝毒や出荷規制の有無を示すものではありません。' : 'Chlorophyll-a is a bloom proxy only; it does not show toxin status or shipment restrictions.'}</p>
        </section>}
        {habText && <p class="map-help">{habText}</p>}
        <div class="map-legend"><span><i class="legend-plot"></i>{lang === 'ja' ? '養殖区画' : 'Farm plot'}</span><span><i class="legend-demo"></i>{lang === 'ja' ? 'デモ区画' : 'Demo plot'}</span><span><i class="legend-zone"></i>{lang === 'ja' ? '概略海域' : 'Approximate sea area'}</span></div>
        {plot && <p class="source-note">{lang === 'ja' ? '選択中' : 'Selected'} {plot.plotCode} · {plot.centroid[1].toFixed(4)}°N, {plot.centroid[0].toFixed(4)}°E · {lang === 'ja' ? (plot.source === 'demo' ? 'デモ用形状' : plot.source === 'msil' ? 'MSIL区画' : '登録区画') : plotSource}{plot.prefecture ? ` · ${plot.prefecture}` : ''}{plot.seaArea ? ` · ${plot.seaArea}` : ''}</p>}

        <div class="map-legend">
          <span><i class="legend-plot" aria-hidden="true"></i>{lang === 'ja' ? '養殖区画' : 'Farm plot'}</span>
          <span><i class="legend-demo" aria-hidden="true"></i>{lang === 'ja' ? 'デモ区画' : 'Demo plot'}</span>
          <span><i class="legend-zone" aria-hidden="true"></i>{lang === 'ja' ? '概略海域' : 'Approximate sea area'}</span>
        </div>

        {plot && <p class="source-note">
          {lang === 'ja' ? '選択中' : 'Selected'} {plot.plotCode}
          · {plot.centroid[1].toFixed(4)}°N, {plot.centroid[0].toFixed(4)}°E
          · {plotSource}
          {plot.prefecture ? ` · ${plot.prefecture}` : ''}
          {plot.seaArea ? ` · ${plot.seaArea}` : ''}
        </p>}
      </section>

      <aside class="detail-rail" aria-label={lang === 'ja' ? '選択区画の観測値' : 'Selected plot observations'}>
        <section class="detail-card">
          <p class="eyebrow">{copy.selected}</p>
          {plot ? <>
            <h2>{plot.plotCode}</h2>
            <p>{plot.species.map(speciesName).join(' · ') || '—'}</p>
            <p class="source-note">{plotSource}</p>
            <p class="source-note">{plot.areaM2.toLocaleString(lang === 'ja' ? 'ja-JP' : 'en-US')} m²{plot.operation ? ` · ${plot.operation}` : ''}</p>
          </> : <>
            <h2>{copy.noPlot}</h2>
            <p>{copy.noPlotDetail}</p>
          </>}
        </section>

        <HmiObservations data={data} metric={metric} lang={lang} season={season} title={metricName} message={riskText || copy.noObservations} />

        <section class="detail-card">
          <p class="eyebrow">{copy.references}</p>
          <h2>{speciesData ? `${speciesData.name} · ${speciesData.nameJa}` : species ? speciesName(species) : copy.species}</h2>
          {speciesData && <p class="source-note">{speciesData.taxon}</p>}
          {speciesText
            ? <p>{speciesText}</p>
            : counts.length
              ? counts.map(({ rule, count }) => <div class="threshold">
                  <div>
                    <strong>{lang === 'ja' ? `段階 ${rule.tier}` : `Tier ${rule.tier}`}</strong>
                    <span>{rule.tempC == null ? '—' : `${rule.tempC}°C / ${(rule.tempC * 9 / 5 + 32).toFixed(1)}°F`} · {rule.window?.start} – {rule.window?.end}</span>
                  </div>
                  <b>{count}/{rule.threshold}{lang === 'ja' ? '日' : ' days'}</b>
                </div>)
              : <p>{copy.noThreshold}</p>}
          {speciesData && <p class="coverage">{lang === 'ja' ? 'ルール' : 'Rules'} {speciesData.rules_version} · {lang === 'ja' ? 'プロファイル' : 'profiles'} {speciesData.profile_version}</p>}
          {speciesData && !!speciesData.evidence.length && <details class="species-evidence">
            <summary>{lang === 'ja' ? '魚種の根拠資料' : 'Species evidence'}</summary>
            {speciesData.evidence.map((study) => <p class="coverage">
              <a href={study.url} target="_blank" rel="noopener noreferrer">{study.id}</a>
              · {study.factors.join(', ').replaceAll('_', ' ')}
              · {study.lifeStage ?? (lang === 'ja' ? '成長段階の記録なし' : 'life stage unrecorded')}
              · {study.status === 'measured' ? `${study.points.length} ${lang === 'ja' ? '測定点' : 'measured points'}` : (lang === 'ja' ? '対応データなし' : 'no supported response data')}
              {study.note && <><br />{study.note}</>}
            </p>)}
          </details>}
          <p class="layer-note">{copy.countOnly}</p>
        </section>
      </aside>
    </div>

    <footer class="hmi-foot">
      {copy.source}: {lang === 'ja'
        ? '検証済み区画観測はパイプライン由来。背景地図・NASAレイヤーは参考表示です。'
        : 'Validated plot observations come from the pipeline; basemap and NASA overlays are visual context.'}
    </footer>
  </div>
</BaseLayout>

<script>
  import L from 'leaflet';

  const page = document.querySelector<HTMLElement>('.hmi-page');
  const copy = JSON.parse(page?.dataset.copy ?? '{}') as Record<string, string>;
  const season = page?.dataset.season ?? '2025';
  const lang = page?.dataset.lang ?? 'en';
  const features = JSON.parse(page?.dataset.mapFeatures ?? '{"plots":[],"zones":[]}') as {
    plots: { plotCode: string; centroid: [number, number]; geometry: GeoJSON.Geometry; source: string; selected: boolean }[];
    zones: { geometry: GeoJSON.Geometry; name: string }[];
  };

  const element = document.querySelector<HTMLElement>('#hmi-map');
  const map = element && L.map(element, {
    minZoom: 6,
    maxZoom: 16,
    zoomControl: false,
    attributionControl: false,
    preferCanvas: true,
  }).setView([38.85, 141.8], 7);

  if (map) {
    const regionBounds = L.latLngBounds([[37.2, 140.5], [40.5, 143.1]]);
    map.setMaxBounds([[36.8, 139.9], [41.0, 143.7]]);

    const params = new URLSearchParams(location.search);
    const savedLat = Number(params.get('lat'));
    const savedLng = Number(params.get('lng'));
    const savedZoom = Number(params.get('zoom'));
    if (Number.isFinite(savedLat) && Number.isFinite(savedLng) && Number.isFinite(savedZoom)
      && savedLat >= 36.8 && savedLat <= 41 && savedLng >= 139.9 && savedLng <= 143.7 && savedZoom >= 6 && savedZoom <= 16) {
      map.setView([savedLat, savedLng], savedZoom);
    } else {
      map.fitBounds(regionBounds, { padding: [10, 10] });
    }

    const imagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      maxZoom: 19,
    });
    const gibs = 'https://gibs.earthdata.nasa.gov/wms/epsg3857/best/wms.cgi';
    const overlays: Record<string, L.TileLayer> = {
      sst: L.tileLayer.wms(gibs, { layers: 'GHRSST_L4_MUR_Sea_Surface_Temperature', format: 'image/png', transparent: true, opacity: 0.72, version: '1.1.1', attribution: 'NASA GIBS / GHRSST MUR' }),
      anom: L.tileLayer.wms(gibs, { layers: 'GHRSST_L4_MUR_Sea_Surface_Temperature_Anomalies', format: 'image/png', transparent: true, opacity: 0.72, version: '1.1.1', attribution: 'NASA GIBS / GHRSST MUR' }),
      chl: L.tileLayer.wms(gibs, { layers: 'OCI_PACE_Chlorophyll_a', format: 'image/png', transparent: true, opacity: 0.78, version: '1.1.1', attribution: 'NASA GIBS / PACE OCI' }),
    };
    // JAXA SGLI chl-a from the pipeline's own layers, proxied same-origin; bounded so no tiles are asked for outside the grid.
    const habOverlay = page?.dataset.habOverlay ? JSON.parse(page.dataset.habOverlay) as { url: string; bounds: L.LatLngBoundsLiteral } : null;
    if (habOverlay) overlays.hab = L.tileLayer(habOverlay.url, { bounds: habOverlay.bounds, maxNativeZoom: 12, maxZoom: 16, opacity: 0.85, attribution: 'JAXA SGLI' });
    const habLegend = document.querySelector<HTMLElement>('[data-hab-legend]');
    const tileStatus = document.querySelector<HTMLElement>('[data-map-tile-status]');
    let activeLayer = 'satellite';
    let tileFailures = 0;
    const monitorTiles = (layer: L.TileLayer, name: string) => layer
      .on('loading', () => {
        tileFailures = 0;
        if (activeLayer === name && tileStatus) tileStatus.hidden = true;
      })
      .on('tileerror', () => {
        tileFailures += 1;
        if (activeLayer === name && tileFailures >= 2 && tileStatus) tileStatus.hidden = false;
      });

    monitorTiles(imagery, 'satellite').addTo(map);
    Object.entries(overlays).forEach(([name, layer]) => monitorTiles(layer, name));

    let drawing = false;
    let busy = false;
    const drawLayer = L.layerGroup().addTo(map);
    const dataLayer = L.layerGroup().addTo(map);

    features.zones.forEach((zone) => {
      L.geoJSON(zone.geometry, {
        style: { color: '#7b6c35', weight: 1.5, dashArray: '5 4', fillColor: '#e8db99', fillOpacity: 0.12 },
      }).bindTooltip(zone.name).addTo(dataLayer);
    });

    features.plots.forEach((plot) => {
      const style = {
        color: plot.selected ? '#122f34' : plot.source === 'demo' ? '#725c23' : '#a6402e',
        weight: plot.selected ? 4 : 2,
        dashArray: plot.selected ? '8 4' : plot.source === 'demo' ? '5 3' : undefined,
        fillColor: plot.source === 'demo' ? '#e6b94f' : '#eb6046',
        fillOpacity: plot.selected ? 0.42 : 0.28,
      };
      L.geoJSON(plot.geometry, { style })
        .bindTooltip(plot.plotCode, { permanent: plot.selected, direction: 'top' })
        .on('click', () => {
          if (drawing || busy) return;
          const next = new URLSearchParams(location.search);
          const center = map.getCenter();
          next.set('plot', plot.plotCode);
          next.set('lat', center.lat.toFixed(5));
          next.set('lng', center.lng.toFixed(5));
          next.set('zoom', String(map.getZoom()));
          location.assign('/hmi?' + next.toString());
        })
        .addTo(dataLayer);

      L.circleMarker([plot.centroid[1], plot.centroid[0]], {
        radius: plot.selected ? 9 : 6,
        color: plot.selected ? '#122f34' : '#fff',
        weight: plot.selected ? 3 : 2,
        fillColor: plot.source === 'demo' ? '#e6b94f' : '#eb6046',
        fillOpacity: 1,
      }).bindTooltip(plot.plotCode).on('click', () => {
        if (drawing || busy) return;
        const next = new URLSearchParams(location.search);
        const center = map.getCenter();
        next.set('plot', plot.plotCode);
        next.set('lat', center.lat.toFixed(5));
        next.set('lng', center.lng.toFixed(5));
        next.set('zoom', String(map.getZoom()));
        location.assign('/hmi?' + next.toString());
      }).addTo(dataLayer);

    });

    const centerOutput = document.querySelector<HTMLOutputElement>('[data-map-center]');
    const setCenter = () => {
      const center = map.getCenter();
      if (centerOutput) centerOutput.value = `${Math.abs(center.lat).toFixed(2)}°${center.lat < 0 ? 'S' : 'N'} · ${Math.abs(center.lng).toFixed(2)}°${center.lng < 0 ? 'W' : 'E'}`;
    };
    map.on('moveend', setCenter);
    setCenter();

    const layerButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-map-layer]')];
    const layerNote = document.querySelector<HTMLElement>('[data-map-layer-note]');
    const layerNotes: Record<string, string> = lang === 'ja' ? {
      satellite: '衛星画像のみ · Esri World Imagery',
      sst: 'NASA GIBS · 日別解析海面水温（MUR） · °C',
      anom: 'NASA GIBS · 海面水温偏差（MUR） · °C',
      chl: 'NASA PACE OCI · クロロフィルa · mg/m³',
    } : {
      satellite: 'Imagery only · Esri World Imagery',
      sst: 'NASA GIBS · Daily analyzed SST (MUR) · °C',
      anom: 'NASA GIBS · SST anomaly (MUR) · °C',
      chl: 'NASA PACE OCI · Chlorophyll-a · mg/m³',
    };

    const activate = (name: string) => {
      activeLayer = name;
      tileFailures = 0;
      if (tileStatus) tileStatus.hidden = true;
      Object.values(overlays).forEach((layer) => map.removeLayer(layer));
      if (name !== 'satellite') overlays[name]?.addTo(map);
      if (habLegend) habLegend.hidden = name !== 'hab';
      layerButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mapLayer === name)));
      if (layerNote) layerNote.textContent = layerNotes[name] ?? layerNotes.satellite;
    };

    layerButtons.forEach((button) => button.addEventListener('click', () => activate(button.dataset.mapLayer ?? 'satellite')));
    document.querySelector<HTMLButtonElement>('[data-map-tiles-retry]')?.addEventListener('click', () => {
      tileFailures = 0;
      if (tileStatus) tileStatus.hidden = true;
      if (activeLayer === 'satellite') imagery.redraw();
      else overlays[activeLayer]?.redraw();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-map-zoom]').forEach((button) => button.addEventListener('click', () => {
      if (button.dataset.mapZoom === 'reset') {
        const selected = features.plots.find((plot) => plot.selected);
        if (selected) map.setView([selected.centroid[1], selected.centroid[0]], 12);
        else map.fitBounds(regionBounds, { padding: [10, 10] });
      } else if (button.dataset.mapZoom === 'in') map.zoomIn();
      else map.zoomOut();
    }));

    const drawButton = document.querySelector<HTMLButtonElement>('[data-area-draw]');
    const runButton = document.querySelector<HTMLButtonElement>('[data-area-run]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-area-clear]');
    const areaHelp = document.querySelector<HTMLElement>('[data-area-help]');
    const areaResult = document.querySelector<HTMLElement>('[data-area-result]');
    let coordinates: [number, number][] = [];
    let sketch: L.Polygon | undefined;

    const redraw = () => {
      if (sketch) drawLayer.removeLayer(sketch);
      sketch = coordinates.length
        ? L.polygon(coordinates.map(([lng, lat]) => [lat, lng]), {
            color: '#9e4b34',
            weight: 3,
            dashArray: '6 4',
            fillColor: '#f5b84b',
            fillOpacity: 0.18,
          }).addTo(drawLayer)
        : undefined;
      if (runButton) runButton.disabled = coordinates.length < 3 || busy;
      if (clearButton) clearButton.disabled = coordinates.length === 0 && !drawing;
    };

    drawButton?.addEventListener('click', () => {
      if (busy) return;
      drawing = !drawing;
      if (drawing) {
        coordinates = [];
        if (areaResult) areaResult.hidden = true;
        map.getContainer().classList.add('drawing');
        drawButton.textContent = copy.cancel;
        drawButton.setAttribute('aria-pressed', 'true');
      } else {
        map.getContainer().classList.remove('drawing');
        drawButton.textContent = copy.draw;
        drawButton.setAttribute('aria-pressed', 'false');
      }
      redraw();
    });

    map.on('click', (event: L.LeafletMouseEvent) => {
      if (!drawing || busy) return;
      coordinates.push([event.latlng.lng, event.latlng.lat]);
      redraw();
    });

    clearButton?.addEventListener('click', () => {
      if (busy) return;
      drawing = false;
      coordinates = [];
      map.getContainer().classList.remove('drawing');
      if (drawButton) {
        drawButton.textContent = copy.draw;
        drawButton.setAttribute('aria-pressed', 'false');
      }
      redraw();
      if (areaHelp) areaHelp.textContent = copy.help + ' ' + copy.extent;
      if (areaResult) {
        areaResult.hidden = true;
        areaResult.removeAttribute('data-error');
        areaResult.textContent = '';
      }
    });

    runButton?.addEventListener('click', async () => {
      if (coordinates.length < 3 || !areaResult || busy) return;
      busy = true;
      drawing = false;
      map.getContainer().classList.remove('drawing');
      if (drawButton) {
        drawButton.textContent = copy.draw;
        drawButton.setAttribute('aria-pressed', 'false');
        drawButton.disabled = true;
      }
      const ring = [...coordinates, coordinates[0]];
      areaResult.hidden = false;
      areaResult.removeAttribute('data-error');
      areaResult.textContent = copy.sampling;
      runButton.disabled = true;

      try {
        const response = await fetch('/api/risk/heat/area', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            feature: { type: 'Feature', properties: null, geometry: { type: 'Polygon', coordinates: [ring] } },
            start: season + '-06-01',
            end: season + '-10-31',
          }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Area analysis unavailable.');
        const observed = result.indices.filter((item: { index: string; value: number | null }) => item.index === 'SST' && item.value !== null);
        const values = observed.map((item: { value: number }) => item.value);
        if (!values.length) {
          areaResult.textContent = copy.noData;
        } else {
          const mean = values.reduce((sum: number, value: number) => sum + value, 0) / values.length;
          const min = Math.min(...values);
          const max = Math.max(...values);
          areaResult.textContent = lang === 'ja'
            ? `平均 ${mean.toFixed(1)}°C · 範囲 ${min.toFixed(1)}–${max.toFixed(1)}°C · 観測 ${values.length}日`
            : `Mean ${mean.toFixed(1)}°C · range ${min.toFixed(1)}–${max.toFixed(1)}°C · ${values.length} observed days`;
        }
      } catch (error) {
        areaResult.dataset.error = 'true';
        areaResult.textContent = lang === 'ja'
          ? '範囲を解析できませんでした。区画別の観測データは引き続き利用できます。'
          : error instanceof Error ? error.message : 'Area analysis unavailable.';
      } finally {
        busy = false;
        if (drawButton) drawButton.disabled = false;
        redraw();
      }
    });

    setTimeout(() => map.invalidateSize(), 0);
  }
</script>
<style>
