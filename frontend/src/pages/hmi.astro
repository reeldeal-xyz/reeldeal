  .hmi-heading { display: flex; justify-content: space-between; align-items: end; gap: 18px; margin-bottom: 20px; }.heading-tools { display: flex; align-items: center; flex-wrap: wrap; justify-content: end; gap: 9px; }.language { display: flex; align-items: center; gap: 4px; }.language a { min-height: 36px; display: inline-flex; align-items: center; padding: 0 9px; border: 1px solid #c7d6d1; border-radius: 6px; color: var(--hmi-muted); text-decoration: none; font-size: .74rem; }.language a[aria-current="page"] { color: var(--hmi-ink); border-color: #124750; background: #edf5ed; font-weight: 800; }
  h1,h2,p { margin: 0; } h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05; letter-spacing: -.04em; } h2 { font-size: 1.05rem; line-height: 1.2; }
