---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContributionSplit from '../../components/molecules/relief/ContributionSplit.astro';
import Amount from '../../components/atoms/Amount.astro';
import CheckoutForm from '../../components/solid/CheckoutForm.tsx';
import { DEMO_LISTING } from '../../fixtures/market-checkout-demo';
import { jpycFromBaseUnits } from '../../lib/format-amount';
import { DEPLOYED } from '@repo/shared';

const total = DEMO_LISTING.totalWei;
const reliefAmount = (total * BigInt(DEMO_LISTING.reliefBps)) / 10_000n;
const sellerAmount = total - reliefAmount;
const fundShareLabel = `${(DEMO_LISTING.reliefBps / 100).toFixed(2)}%`;

const listingForIsland = {
  listingId: DEMO_LISTING.listingId,
  sellerAddress: DEMO_LISTING.sellerAddress,
  totalWei: total.toString(),
  reliefBps: DEMO_LISTING.reliefBps,
};
---

<BaseLayout title="Checkout demo" description="ReelDeal marketplace checkout demo: SaleRouter quote, JPYC approve, and on-chain checkout.">
  <div class="checkout-demo-page shell">
    <header class="checkout-demo-heading">
      <p class="eyebrow">REELDEAL · MARKET CHECKOUT DEMO</p>
      <h1>{DEMO_LISTING.titleJa}</h1>
      <p>{DEMO_LISTING.titleEn} · SaleRouter <code>{DEPLOYED.SaleRouter}</code> on Sepolia</p>
      <p class="notice">Demo listing only -- there is no listings inventory yet. Checkout signs a fresh server-side quote and broadcasts real Sepolia transactions from your wallet.</p>
    </header>

    <div class="checkout-demo-amount">
      <span>合計 / Total</span>
      <strong><Amount value={jpycFromBaseUnits(total) ?? '0'} /></strong>
    </div>

    <ContributionSplit
      reference={`listing:${DEMO_LISTING.listingId.slice(0, 10)}…`}
      saleAmount={jpycFromBaseUnits(total) ?? '0'}
      sellerAmount={jpycFromBaseUnits(sellerAmount) ?? '0'}
      fundAmount={jpycFromBaseUnits(reliefAmount) ?? '0'}
      fundShareLabel={fundShareLabel}
      state="proposed"
      explanation="Split computed as floor(total * reliefBps / 10000); the seller always receives the exact remainder. This is the proposed split -- the confirmed split comes from the signed quote returned by /api/market/quote."
    />

    <CheckoutForm listing={listingForIsland} client:load />
  </div>
</BaseLayout>

<style>
  .checkout-demo-page { display: grid; gap: var(--space-5); max-width: 640px; padding-block: var(--space-6); margin-inline: auto; }
  .checkout-demo-heading { display: grid; gap: var(--space-2); }
  .checkout-demo-heading h1 { margin: 0; font: 900 clamp(1.5rem, 6vw, 2rem)/1.1 var(--font-impact); letter-spacing: -.03em; }
  .checkout-demo-heading p { margin: 0; color: var(--color-ink-soft); font-size: .85rem; overflow-wrap: anywhere; }
  .checkout-demo-heading code { font-size: .78rem; }
  .eyebrow { margin: 0; font-family: var(--font-impact); font-size: .72rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: var(--color-ink-soft); }
  .notice { padding: var(--space-3) var(--space-4); border: 2px solid var(--color-ink); border-radius: var(--radius-card); background: var(--color-cream); }
  .checkout-demo-amount { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); padding: var(--space-4); border: 2px solid var(--color-ink); border-radius: var(--radius-card); background: var(--color-surface); }
  .checkout-demo-amount span { font-family: var(--font-impact); font-size: .78rem; text-transform: uppercase; }
  .checkout-demo-amount strong { font-size: 1.5rem; }
</style>
