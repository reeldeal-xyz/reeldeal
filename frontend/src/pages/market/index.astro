---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketEmpty from '../../components/molecules/marketplace/MarketEmpty.astro';
import WalletConnect from '../../components/react/WalletConnect';
import { NEXT_PUBLIC_REOWN_PROJECT_ID } from 'astro:env/server';
---

<BaseLayout title="Fish market" description="Fishery listings from the Miyagi coast." section="market">
  <div class="shell market-page">
    <header class="market-page__heading">
      <div><p>REELDEAL · MIYAGI COAST</p><h1>Fish market</h1></div>
      <WalletConnect projectId={NEXT_PUBLIC_REOWN_PROJECT_ID} client:only="react" />
    </header>
    <MarketEmpty />
    <a class="market-page__coast" href="/hmi">Explore the coast</a>
  </div>
</BaseLayout>

<style>
  .market-page { min-height: 60dvh; padding-block: clamp(30px, 6vw, 68px); }
  .market-page__heading { display: flex; align-items: start; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 28px; }
  .market-page__heading p { margin: 0 0 8px; font-size: 11px; font-weight: 800; letter-spacing: .08em; }
  .market-page__heading h1 { margin: 0; font: 900 clamp(34px, 7vw, 64px)/1 var(--font-impact); }
  .market-page :global(.market-empty-state) { max-width: 680px; }
  .market-page__coast { display: inline-block; margin-top: 22px; color: var(--color-ink); font-weight: 750; text-underline-offset: 3px; }
</style>
