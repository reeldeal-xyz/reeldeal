---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketplaceDiscovery from '../../components/organisms/marketplace/MarketplaceDiscovery.astro';
import WalletConnect from '../../components/react/WalletConnect';
import MarketActivity from '../../components/molecules/marketplace/MarketActivity.astro';
import { NEXT_PUBLIC_REOWN_PROJECT_ID, SEPOLIA_RPC_URL } from 'astro:env/server';
import { createSepoliaClient } from '../../lib/chain/client.server';
import { getMarketActivity } from '../../lib/market-activity.server';
const activity = await getMarketActivity(createSepoliaClient(SEPOLIA_RPC_URL));
Astro.response.headers.set('cache-control', 'no-store');
---

<BaseLayout title="Fish market" description="Buy Kesennuma seafood in JPYC; 5% of every sale goes to the ReelDeal relief fund." section="market">
  <div class="shell market-page">
    <header class="market-page__heading">
      <div><p>REELDEAL · MIYAGI COAST</p><h1>Fish market</h1></div>
      <WalletConnect projectId={NEXT_PUBLIC_REOWN_PROJECT_ID} client:only="react" />
    </header>
  </div>
  <MarketplaceDiscovery live />
  <div class="shell market-ledger"><MarketActivity activity={activity} /></div>
</BaseLayout>

<style>
  :global(.app-frame:has(.market-page)) { max-width: 1040px; margin-inline: auto; }
  :global(.app-frame:has(.market-page) .shell) { max-width: 960px; }
  .market-ledger { padding-block: 24px; }
  .market-page { padding-block: 32px 0; }
  .market-page__heading { display: flex; align-items: start; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
  .market-page__heading p { margin: 0 0 8px; font-size: 11px; font-weight: 800; letter-spacing: .08em; }
  .market-page__heading h1 { margin: 0; font: 900 clamp(30px, 4vw, 42px)/1 var(--font-impact); }
</style>
