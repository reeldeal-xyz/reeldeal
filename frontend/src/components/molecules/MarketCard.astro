---
import Badge from '../atoms/Badge.astro';
import Button from '../atoms/Button.astro';
import type { PreviewLot } from '../../fixtures/preview-lots';

const { lot, first = false, href = '#offer', index = 0, labels = {} } = Astro.props as {
  lot: PreviewLot; first?: boolean; href?: string; index?: number;
  labels?: { preview?: string; sample?: string; view?: string; imageAlt?: string };
};
const tones = ['lime', 'pink', 'yellow', 'blue'];
---

<article class={`market-card market-card--${tones[index % tones.length]} market-card--preview`} aria-labelledby={`market-${lot.id}`}>
  <div class="market-card__media">
    <img src="/images/landing-placeholder.png" width="480" height="360"
      alt={labels.imageAlt ?? 'Illustrated fish silhouette; no landing photograph'} loading={first ? 'eager' : 'lazy'} />
    <div class="market-card__image-copy">
      <Badge label={labels.preview ?? 'Preview'} tone="yellow" class="market-card__status" />
      <div class="market-card__image-facts">
        <h2 id={`market-${lot.id}`}>{lot.species}</h2>
        <p><span>{lot.weightG.toLocaleString('ja-JP')} g</span><span class="market-card__fact-divider"> · </span><span>{lot.lengthMm} mm</span></p>
        <small>{labels.sample ?? 'Sample landing'}</small>
      </div>
    </div>
  </div>
  <div class="market-card__foot">
    <strong>¥{lot.priceJpy.toLocaleString('ja-JP')}</strong>
    <Button href={href} variant="secondary" tone="ink" class="market-card__action">{labels.view ?? 'View'}</Button>
  </div>
</article>
