---
import Badge from '../../atoms/Badge.astro';
import Status from '../../atoms/Status.astro';
import type { EquipmentCardProps } from './resource-props';
import './relief.css';

interface Props extends EquipmentCardProps {}
const { name, nameJa, state, typeLabel, description, farmLabels, explanation } = Astro.props;
---

<section class="relief-card" aria-label={name} aria-busy={state === 'loading'}>
  <div class="relief-card__head">
    <div>
      {nameJa && <p class="relief-card__label" lang="ja">{nameJa}</p>}
      <h2 class="relief-card__title">{name}</h2>
    </div>
    {state === 'ready' && <Badge label="Equipment" tone="yellow" />}
    {state === 'empty' && <Badge label="No equipment" tone="ink" />}
    {(state === 'loading' || state === 'unavailable') && <Status state={state} />}
  </div>
  {state === 'ready' && <dl class="relief-card__facts">
    <div class="relief-card__fact"><dt>Type</dt><dd>{typeLabel}</dd></div>
    <div class="relief-card__fact"><dt>Description</dt><dd>{description}</dd></div>
    <div class="relief-card__fact"><dt>Used at</dt><dd>{farmLabels.length ? farmLabels.join(' · ') : 'No farm listed'}</dd></div>
  </dl>}
  <p class="relief-card__note">{explanation}</p>
</section>
