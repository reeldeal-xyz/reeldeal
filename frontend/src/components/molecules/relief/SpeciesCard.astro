---
import Badge from '../../atoms/Badge.astro';
import Status from '../../atoms/Status.astro';
import type { SpeciesCardProps } from './resource-props';
import './relief.css';

interface Props extends SpeciesCardProps {}
const { name, nameJa, state, categoryLabel, riskLabels, thresholdLabel, explanation } = Astro.props;
---

<section class="relief-card" aria-label={name} aria-busy={state === 'loading'}>
  <div class="relief-card__head">
    <div>
      {nameJa && <p class="relief-card__label" lang="ja">{nameJa}</p>}
      <h2 class="relief-card__title">{name}</h2>
    </div>
    {state === 'ready' && <Badge label="Species" tone="lime" />}
    {state === 'empty' && <Badge label="No species" tone="ink" />}
    {(state === 'loading' || state === 'unavailable') && <Status state={state} />}
  </div>
  {state === 'ready' && <dl class="relief-card__facts">
    <div class="relief-card__fact"><dt>Category</dt><dd>{categoryLabel}</dd></div>
    <div class="relief-card__fact"><dt>Monitored risks</dt><dd>{riskLabels.length ? riskLabels.join(' · ') : 'No risks listed'}</dd></div>
    <div class="relief-card__fact"><dt>Thresholds</dt><dd>{thresholdLabel}</dd></div>
  </dl>}
  <p class="relief-card__note">{explanation}</p>
</section>
