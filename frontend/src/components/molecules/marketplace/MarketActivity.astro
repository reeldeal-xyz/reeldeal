---
import type { MarketActivity } from '../../../lib/market-activity.server';
import { DEPLOYED, getListing } from '@repo/shared';
import Amount from '../../atoms/Amount.astro';
import { jpycFromBaseUnits } from '../../../lib/format-amount';
interface Props { activity: MarketActivity }
const { activity } = Astro.props;
---
<section class="market-activity" aria-labelledby="market-activity-title">
  <header><h2 id="market-activity-title">Market transactions</h2><span>Sepolia · JPYC</span></header>
  {activity.available ? activity.sales.length ? <ul>
    {activity.sales.slice(0, 6).map((sale) => <li>
      <div><strong>{sale.listing ? getListing(sale.listing)?.name : 'Market purchase'}{sale.lot && ` · lot ${sale.lot}`}</strong>
        <a href={`https://sepolia.etherscan.io/tx/${sale.txHash}`} target="_blank" rel="noopener noreferrer">View transaction ↗</a></div>
      <dl>
        <div><dt>Paid</dt><dd><Amount value={jpycFromBaseUnits(sale.total)!} /></dd></div>
        <div><dt>Seller</dt><dd><Amount value={jpycFromBaseUnits(sale.sellerAmount)!} /></dd></div>
        <div><dt>Relief · {sale.reliefBps / 100}%</dt><dd><Amount value={jpycFromBaseUnits(sale.reliefAmount)!} /></dd></div>
      </dl>
    </li>)}
  </ul> : <p>No confirmed market purchases yet.</p> : <p role="status">Transaction history unavailable. <a href="">Retry</a></p>}
  {activity.atBlock && <details><summary>Ledger details</summary><p>Through block {activity.atBlock}. SaleRouter purchases matched to ReliefPool contributions.</p><a href={`https://sepolia.etherscan.io/address/${DEPLOYED.SaleRouter}#events`} target="_blank" rel="noopener noreferrer">Contract activity ↗</a></details>}
</section>
<style>
  .market-activity { min-width: 0; padding: 20px; border: 2px solid var(--color-ink); border-radius: var(--radius-card); background: var(--color-surface); }
  header { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; justify-content: space-between; }
  h2 { margin: 0; font: 800 22px/1.2 var(--font-body); } header span,dt,summary { font-size: 12px; color: var(--color-ink-soft); }
  ul { padding: 0; margin: 16px 0 0; list-style: none; } li { padding: 16px 0; border-top: 1px solid var(--color-line); }
  li > div { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  li a { font-size: 13px; min-height: 44px; display: inline-flex; align-items: center; }
  dl { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin: 8px 0 0; } dd { margin: 2px 0 0; font-weight: 750; overflow-wrap: anywhere; }
  details p { font-size: 12px; } summary { cursor: pointer; padding-block: 12px; }
  @media(max-width: 420px) { dl { grid-template-columns: 1fr; gap: 4px; } dl > div { display: flex; justify-content: space-between; gap: 8px; } }
</style>
