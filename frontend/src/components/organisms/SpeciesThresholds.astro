---
import type { PipelineHeatRisk, PipelinePlotRecord, PipelineSpeciesDetail } from '@repo/shared';
import { thresholdView } from '../../lib/hmi-thresholds';
interface Props { species: string; season: string; plot?: PipelinePlotRecord; data: PipelineHeatRisk | null; profile?: PipelineSpeciesDetail | null; lang?: 'en' | 'ja' }
const { species, season, plot, data, profile, lang = 'en' } = Astro.props;
const ja = lang === 'ja';
const view = thresholdView(species, season, data, plot, profile);
const name = species === 'scallop' ? (ja ? 'ホタテ' : 'Scallop') : species === 'hoya' ? (ja ? 'ホヤ（マボヤ）' : 'Sea pineapple (hoya)') : profile ? (ja ? profile.nameJa : profile.name) : species;
---
<div class="species-thresholds" data-threshold-species={species}>
  <p class="shelf-kicker">{name || (ja ? '魚種未選択' : 'No species selected')} · {season}</p>
  <div class="threshold-observed">
    <span>{ja ? '直近の観測水温' : 'Recorded sea temperature'}</span>
    {view.latestSst?.value !== null && view.latestSst ? <>
      <strong>{view.latestSst.value.toFixed(1)}°C <small>/ {(view.latestSst.value * 9 / 5 + 32).toFixed(1)}°F</small></strong>
      <time datetime={view.latestSst.asOf}>{view.latestSst.asOf}</time>
    </> : <strong>{ja ? '観測データなし' : 'Unavailable'}</strong>}
  </div>
  <p class="threshold-purpose">{view.heat.length
    ? (ja ? '補償基準に達する水温と日数。' : 'Temperature and exposure required for heat relief.')
    : view.bans.length ? (ja ? '補償は公的な出荷規制で判定します。水温の基準は未設定です。' : 'Relief uses official shipment restrictions. No temperature trigger is configured.')
      : (ja ? '補償基準は未設定です。' : 'No relief rule is configured.')}</p>
  {view.drift && <p class="forecast-notice" role="status">{ja ? 'ルール不一致。集計を停止しています。' : 'Rule mismatch. Exposure count unavailable.'}</p>}
  {view.geometryMismatch && <p class="forecast-notice" role="status">{ja ? '観測値の区画形状が一致しません。' : 'Observations use a different plot boundary.'}</p>}
  {view.invalidObservations && <p class="forecast-notice" role="status">{ja ? '観測値を検証できません。' : 'Observations failed validation.'}</p>}
  {view.heat.map(({ rule, count, missingDays, asOf, reached }) => <section class="threshold-rule" data-threshold-temperature={rule.tempC}>
    <header><strong>≥ {rule.tempC}°C <small>/ {(rule.tempC! * 9 / 5 + 32).toFixed(1)}°F</small></strong><span>{ja ? `段階 ${rule.tier}` : `Tier ${rule.tier}`}</span></header>
    <p class="threshold-progress">{count === null ? '—' : count} / {rule.threshold} {ja ? '観測日' : 'observed days'}</p>
    {count !== null ? <progress max={rule.threshold} value={Math.min(count, rule.threshold)} aria-label={ja ? `${rule.tempC}℃以上の観測日数` : `Observed days at or above ${rule.tempC}°C`} /> : <p class="shelf-note">{ja ? '観測データなし' : 'No matching observations'}</p>}
    {reached && <p class="threshold-reached">{ja ? '観測基準に到達 · 支払は未確認' : 'Exposure reached · payment unconfirmed'}</p>}
    <p class="threshold-limit">{rule.window!.start} – {rule.window!.end}{count !== null && missingDays > 0 && ` · ${missingDays} ${ja ? '日欠測' : 'missing days'}`}{asOf && <span class="sr-only"> · {asOf}</span>}</p>
  </section>)}
  {view.bans.map((rule) => <section class="threshold-rule"><strong>{ja ? '出荷規制' : 'Shipment restriction'}</strong><p class="threshold-limit">{ja ? `公的な規制が${rule.threshold}週間連続` : `${rule.threshold} consecutive weeks · official restrictions`}</p></section>)}
  <details class="data-sources threshold-details"><summary>{ja ? 'ルールの詳細' : 'Rule details'}</summary>
    <p>{ja ? '暫定的な補償ルールです。生物学的な安全限界ではありません。' : 'Provisional relief rules, not biological safety limits.'}</p>
    {view.heat.length > 0 && <p>{ja ? '日ごとの海面水温の観測値を集計します。予報と欠測日は加算しません。' : 'Heat exposure uses observed daily sea-surface temperature. Forecasts and missing days do not count.'}</p>}
    {view.bans.length > 0 && <p>{ja ? '出荷規制の継続期間は公的な記録で確認します。水温からは判定しません。' : 'Shipment restrictions require official records. Temperature alone does not establish a restriction.'}</p>}
    <p>{view.rulesVersion}</p>
    {profile?.evidence.map((study) => <p><a href={study.url} target="_blank" rel="noopener noreferrer">{study.id}</a>{study.note && ` · ${study.note}`}</p>)}
  </details>
</div>
