---
import Badge from '../../atoms/Badge.astro';
import MeasurementRow from '../../molecules/relief/MeasurementRow.astro';
import ProvenanceDetails from '../../molecules/relief/ProvenanceDetails.astro';
import TransactionRow from '../../molecules/relief/TransactionRow.astro';
import { comparisonResult, evidenceFields, isDisplayText, reviewState, type EventVerificationPreview } from './review';

interface Props { review?: EventVerificationPreview | null }
const review = Astro.props.review;
const state = reviewState(review);
const advisory = state === 'advisory';
const labels = {
  matching: 'Fixture comparisons match',
  mismatched: 'Fixture evidence differs',
  unavailable: 'Evidence review unavailable',
  advisory: 'Advisory only',
};
const tones = { matching: 'lime', mismatched: 'pink', unavailable: 'ink', advisory: 'blue' } as const;
const explanations = {
  matching: 'Every required comparison has a matching result in this synthetic fixture. This is not a verified real event or payment.',
  mismatched: 'The supplied fixture results include a mismatch. Inspect the differing fields below; this view does not approve a relief event.',
  unavailable: 'Required event context, comparison results or source evidence is missing. A match cannot be shown.',
  advisory: 'This forecast is for planning. It is not an observed threshold crossing and carries no payout decision.',
};
const modeLabel = review?.mode === 'replay' ? 'Historical observed replay' : review?.mode === 'observed' ? 'Observed data preview' : advisory ? 'Forecast preview' : 'Data mode unavailable';
const display = (value: unknown) => isDisplayText(value) ? value : 'Unavailable';
const measurement = review?.measurement && [review.measurement.label, review.measurement.sourceName, review.measurement.observedAtLabel, review.measurement.freshnessLabel].every(isDisplayText) ? {
  ...review.measurement,
  // Advisory context cannot inherit an Observed badge from a reused reading.
  state: advisory ? 'advisory' as const : review.measurement.state,
} : null;
const provenance = review?.provenance && ['available', 'unavailable'].includes(review.provenance.state)
  && [review.provenance.sourceName, review.provenance.datasetLabel, review.provenance.observedAtLabel, review.provenance.retrievedAtLabel, review.provenance.evidenceLabel].every(isDisplayText) ? review.provenance : null;
const transaction = review?.transaction;
const showTransaction = !advisory && transaction && [transaction.reference, transaction.label, transaction.amount, transaction.timeLabel, transaction.explanation].every(isDisplayText)
  && ['pending', 'paid', 'held', 'unavailable'].includes(transaction.state)
  && /^\d+(\.\d+)?$/.test(transaction.amount);
---

<article class="event-review" aria-label="Event evidence review">
  <header class="event-review__header">
    <p class="event-review__kicker">記録の確認 · Event evidence</p>
    <h1>Review the evidence.</h1>
    <p class="event-review__notice">Synthetic preview · no live readings, chain receipts or payments.</p>
  </header>

  <section class="event-review__summary" aria-label="Review result">
    <Badge label={labels[state]} tone={tones[state]} />
    <h2>{modeLabel}</h2>
    <p>{explanations[state]}</p>
    <dl class="event-review__context">
      <div><dt>Event ID</dt><dd><code>{display(review?.eventId)}</code></dd></div>
      <div><dt>Zone</dt><dd>{display(review?.zone)}</dd></div>
    </dl>
    {review?.mode === 'replay' && <p class="event-review__note">The observation season identifies this replay. The payout season is a separate field; an event ID alone does not select a historical record.</p>}
  </section>

  <section class="event-review__section" aria-label="Reading and source">
    <h2>Reading and source</h2>
    {measurement ? <MeasurementRow {...measurement} /> : <p class="event-review__empty">No complete temperature reading is available for this review.</p>}
    {provenance ? <ProvenanceDetails {...provenance} /> : <p class="event-review__empty">Source provenance is incomplete. No pinned input can be confirmed.</p>}
  </section>

  <section class="event-review__section" aria-label="Required evidence comparisons">
    <h2>{advisory ? 'Event comparisons unavailable' : 'Required comparisons'}</h2>
    <p class="event-review__note">Recorded values and evidence values remain visible together. Results below are supplied by fixtures; this preview performs no verification.</p>
    <div class="event-review__comparisons">
      {evidenceFields.map(([key, label]) => {
        const comparison = review?.comparisons?.[key];
        const result = advisory ? 'unavailable' : comparisonResult(comparison);
        return <section class="event-review__comparison" aria-label={label}>
          <div class="event-review__comparison-head">
            <h3>{label}</h3>
            <Badge label={result === 'match' ? 'Fixture match' : result === 'mismatch' ? 'Fixture mismatch' : 'Unavailable'} tone={result === 'match' ? 'lime' : result === 'mismatch' ? 'pink' : 'ink'} />
          </div>
          <dl>
            <div><dt>Recorded</dt><dd><code>{display(comparison?.recorded)}</code></dd></div>
            <div><dt>Evidence</dt><dd><code>{display(comparison?.evidence)}</code></dd></div>
          </dl>
        </section>;
      })}
    </div>
  </section>

  <section class="event-review__section" aria-label="Separate payment record">
    <h2>Payment record</h2>
    <p class="event-review__note">An evidence result does not establish that funds were paid.</p>
    {showTransaction ? <TransactionRow {...transaction!} /> : <p class="event-review__empty">{advisory ? 'No payment record applies to this forecast preview.' : 'No complete payment record is available.'}</p>}
  </section>
</article>

<style is:inline>
  .event-review { display: grid; gap: var(--space-5); min-width: 0; color: var(--color-ink); overflow-wrap: anywhere; }
  .event-review__header h1 { margin: 0 0 var(--space-4); font: 900 1.8rem/1.1 var(--font-impact); letter-spacing: -.035em; }
  .event-review__kicker { margin: 0 0 var(--space-3); font-size: .75rem; font-weight: 800; text-transform: uppercase; }
  .event-review__notice { margin: 0; padding: var(--space-3) var(--space-4); border-left: 3px solid var(--color-ink); background: var(--color-cream); font-size: .875rem; }
  .event-review__summary { display: grid; justify-items: start; gap: var(--space-4); padding: var(--space-4); border: 2px solid var(--color-ink); border-radius: var(--radius-card); background: var(--color-surface); }
  .event-review__summary h2, .event-review__section > h2 { margin: 0; font: 900 1.125rem/1.3 var(--font-impact); }
  .event-review__summary p { margin: 0; }
  .event-review__context { display: grid; width: 100%; gap: var(--space-3); margin: 0; }
  .event-review__context dt { color: var(--color-ink-soft); font-size: .875rem; }
  .event-review__context dd { margin: var(--space-1) 0 0; }
  .event-review code { font-size: .8rem; line-height: 1.5; overflow-wrap: anywhere; white-space: pre-wrap; }
  .event-review__section { display: grid; gap: var(--space-4); min-width: 0; }
  .event-review__note { margin: 0; color: var(--color-ink-soft); font-size: .875rem; line-height: 1.5; }
  .event-review__empty { margin: 0; padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-card); }
  .event-review__comparisons { display: grid; gap: var(--space-3); }
  .event-review__comparison { padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-card); }
  .event-review__comparison-head { display: flex; align-items: start; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4); }
  .event-review__comparison h3 { flex: 1 1 150px; margin: 0; font: 800 .95rem/1.4 var(--font-body); }
  .event-review__comparison dl { display: grid; gap: var(--space-3); margin: 0; }
  .event-review__comparison dl > div { min-width: 0; }
  .event-review__comparison dt { margin-bottom: var(--space-1); color: var(--color-ink-soft); font-size: .75rem; font-weight: 700; }
  .event-review__comparison dd { margin: 0; }
  @media (min-width: 640px) { .event-review__comparison dl { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); } }
</style>
