---
import Address from '../../atoms/Address.astro';
import Badge from '../../atoms/Badge.astro';
import TransactionRow from '../../molecules/relief/TransactionRow.astro';
import { heldReasonCopy } from '../farmer-relief/props';
import { coopPreviews } from '../../../fixtures/operations-preview';
import { currentFarmer, displayedSlot, expiryLabel } from './guards';
import { identityLabel, slotLabels, type CoopPreview } from './props';
import styles from './operations.css?inline';
import reliefStyles from '../../molecules/relief/relief.css?inline';

interface Props { sample?: keyof typeof coopPreviews }
const { sample = 'overview' } = Astro.props;
const preview: CoopPreview = coopPreviews[sample];
---

<style is:inline set:html={reliefStyles + styles} />
<article class="ops-preview" aria-label="Co-op operations preview">
  <header class="ops-preview__heading"><p>Co-op · karakuwa-east</p><h1>Holders &amp; farmers</h1><p>Compare a plot’s licence holder with its season-slot registration.</p></header>
  <p class="notice">Synthetic preview · no live ENS, identity or payout evidence. Addresses and outcomes are examples.</p>
  <p class="ops-preview__note">Snapshot: {expiryLabel(preview.asOf)}. Slot ownership and identity are separate from event-specific relief eligibility.</p>
  {preview.state !== 'ready' ? <section class="relief-card" aria-label="Plot records"><h2 class="relief-card__title">Plot records</h2><p class="relief-card__note" role="status">{preview.state === 'loading' ? 'Loading example plot records…' : preview.state === 'empty' ? 'No plots in this example.' : 'Plot records are unavailable. Unknown ownership or identity is not an empty registry.'}</p></section> :
    <div class="ops-preview__grid">{preview.rows.map(row => {
      const slot = displayedSlot(row, preview.asOf);
      const farmer = currentFarmer(row, preview.asOf);
      const outcome = row.relief;
      return <section class="ops-preview__plot" aria-label={`Plot ${row.plotLabel}`}>
        <div class="relief-card">
          <div class="relief-card__head"><div><h2 class="relief-card__title">{row.plotLabel}</h2><p class="relief-card__label">Season {row.seasonLabel} · {row.species}</p></div><Badge label={slotLabels[slot]} tone={slot === 'issued' ? 'lime' : slot === 'pending' ? 'yellow' : 'ink'} /></div>
          <dl class="relief-card__facts">
            <div class="relief-card__fact"><dt>Licence holder</dt><dd><Address value={row.holder} compact /></dd></div>
            <div class="relief-card__fact"><dt>Current farmer</dt><dd>{farmer ? <Address value={farmer} compact /> : slot === 'unavailable' ? 'Unavailable' : slot === 'issued' ? 'Wallet unavailable' : 'No active season slot'}</dd></div>
            <div class="relief-card__fact"><dt>Recorded identity</dt><dd>{identityLabel(row.identityLevel)}</dd></div>
            <div class="relief-card__fact"><dt>Slot expiry</dt><dd>{expiryLabel(row.expiresAt)}</dd></div>
          </dl>
          {(slot === 'expired' || slot === 'revoked') && <p class="relief-card__note">The recorded wallet does not establish a current farmer for this {slot} slot. Historical relief remains a separate record.</p>}
        </div>
        {(outcome.kind === 'paid' || outcome.kind === 'held') && <TransactionRow reference={`Sample event · ${row.plotLabel} · ${row.seasonLabel}`} label="Example relief outcome" amount={outcome.amount} recipient={row.reliefRecipient} state={outcome.kind} timeLabel="26 Sep 2026 · 12:00 JST · example" explanation={outcome.kind === 'paid' ? 'Synthetic confirmed-payment state. No funds moved and no receipt is attached. This historical recipient is separate from the current farmer.' : `Recorded Held reason: ${outcome.reason}. ${heldReasonCopy[outcome.reason].detail} Example allocation only; no payment was released and this is not a receipt.`} />}
        {outcome.kind === 'none' && <p class="ops-preview__note">No relief outcome recorded in this example. No amount or eligibility is implied.</p>}
        {outcome.kind === 'unavailable' && <p class="ops-preview__note">Relief outcome unavailable. No amount or payment status can be confirmed.</p>}
        {outcome.kind === 'expired' && <p class="ops-preview__note">Claim window closed · example Swept state. There is no currently held allocation or claim action.</p>}
      </section>;
    })}</div>
  }
  <p class="ops-preview__note">Read-only examples. Plot QR links, exports, science-key actions and live records remain in the existing co-op app.</p>
</article>
