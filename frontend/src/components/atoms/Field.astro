---
import Input from './Input.astro';
interface Props { id: string; label: string; value?: string; hint?: string; error?: string; disabled?: boolean; required?: boolean }
const { id, label, value, hint, error, disabled, required } = Astro.props;
const description = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---
<div class="field">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <Input id={id} name={id} value={value} disabled={disabled} required={required} invalid={!!error} aria-describedby={description} />
  {hint && <p class="field__hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="field__error" id={`${id}-error`} role="alert">{error}</p>}
</div>
