---
interface Props { value?: string; compact?: boolean }
const { value, compact = false } = Astro.props;
const valid = value && /^0x[\da-fA-F]{40}$/.test(value);
---
{valid ? <span class="address" title={value} aria-label={value}><code>{compact ? `${value.slice(0,6)}…${value.slice(-4)}` : value}</code></span> : <span class="address">Wallet unavailable</span>}
