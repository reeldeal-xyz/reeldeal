---
import '../styles/global.css';
import '../styles/market.css';
import '../styles/wallet.css';
const reeldealLogo = '/images/reeldeal-logo.svg';
import BrandIntro from '../components/BrandIntro.astro';
interface Props { title: string; description?: string; section?: string; lang?: 'en' | 'ja' }
const { title, description = 'ReelDeal supports coastal communities through local goods.', section = 'market', lang = 'en' } = Astro.props;
const ja = lang === 'ja';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · ReelDeal</title>
    <link rel="preload" as="image" href={reeldealLogo} />
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          if (sessionStorage.getItem('reeldeal:intro-seen')) return;
          sessionStorage.setItem('reeldeal:intro-seen', '1');
        } catch { /* The intro still works when browser storage is unavailable. */ }
        document.documentElement.setAttribute('data-brand-intro', '');
      })();
    </script>
  </head>
  <body>
    <BrandIntro />
    <div class="app-frame">
      <a class="skip-link" href="#main">{ja ? '本文へ移動' : 'Skip to content'}</a>
      <header class="site-header"><div class="shell site-header__inner">
        <a class="brand" href="/" aria-label={ja ? 'ReelDeal ホーム' : 'ReelDeal home'}>
          <!-- Display the artwork without the source image's outer white margin. -->
          <svg class="brand__logo" viewBox="154 150 946 946" width="48" height="48" aria-hidden="true" focusable="false">
            <image href={reeldealLogo} width="1254" height="1254" />
          </svg>
        </a>
        <nav class="site-nav" aria-label={ja ? 'メインメニュー' : 'Main navigation'}>
          <a href="/market" aria-current={section === 'market' ? 'page' : undefined}>{ja ? '魚市場' : 'Fish market'}</a>
          <a href={ja ? '/hmi?lang=ja' : '/hmi'} aria-current={section === 'hmi' ? 'page' : undefined}>{ja ? '沿岸マップ' : 'Coastal map'}</a>
          <a href="/coop">{ja ? '漁協' : 'Co-op'}</a>
          <a href="/relief" aria-current={section === 'relief' ? 'page' : undefined}>{ja ? '救済' : 'Relief'}</a>
        </nav>
      </div></header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><div class="shell"><p>{ja ? 'ReelDeal · 宮城県沿岸' : 'ReelDeal · Miyagi coast'}</p></div></footer>
    </div>
  </body>
</html>
<style>
  @media (max-width: 380px) {
    .site-header__inner { flex-wrap: wrap; justify-content: center; gap: 8px; padding-block: 8px; }
    .site-nav { flex-basis: 100%; }
  }
</style>
