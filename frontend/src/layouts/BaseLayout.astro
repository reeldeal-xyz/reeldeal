---
import '../styles/global.css';
import '../styles/market.css';
interface Props { title: string; description?: string; section?: string }
const { title, description = 'ReelDeal supports coastal communities through local goods.', section = 'workshop' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · ReelDeal</title>
  </head>
  <body>
    <div class="app-frame">
      <a class="skip-link" href="#main">Skip to content</a>
      <header class="site-header"><div class="shell site-header__inner">
        <a class="brand" href="/">ReelDeal</a>
        <nav class="site-nav" style="grid-template-columns:repeat(2,minmax(0,1fr))" aria-label="Main navigation">
          <a href="/workshop" aria-current={section === 'workshop' ? 'page' : undefined}>Preview</a>
          <a href="/map">Map</a>
        </nav>
      </div></header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><div class="shell"><p>Component preview · synthetic data · no payments or messages</p></div></footer>
    </div>
  </body>
</html>
