---
import '../styles/global.css';
import '../styles/market.css';
import '../styles/wallet.css';
import reeldealLogo from '../../../docs/assets/reeldeal-logo.svg?url';
import BrandIntro from '../components/BrandIntro.astro';
interface Props { title: string; description?: string; section?: string }
const { title, description = 'ReelDeal supports coastal communities through local goods.', section = 'market' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · ReelDeal</title>
    <link rel="preload" as="image" href={reeldealLogo} />
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          if (sessionStorage.getItem('reeldeal:intro-seen')) return;
          sessionStorage.setItem('reeldeal:intro-seen', '1');
        } catch { /* The intro still works when browser storage is unavailable. */ }
        document.documentElement.setAttribute('data-brand-intro', '');
      })();
    </script>
  </head>
  <body>
    <BrandIntro />
    <div class="app-frame">
      <a class="skip-link" href="#main">Skip to content</a>
      <header class="site-header"><div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="ReelDeal home">
          <!-- Display the artwork without the source image's outer white margin. -->
          <svg class="brand__logo" viewBox="154 150 946 946" width="48" height="48" aria-hidden="true" focusable="false">
            <image href={reeldealLogo} width="1254" height="1254" />
          </svg>
        </a>
        <nav class="site-nav" style="grid-template-columns:repeat(2,minmax(0,1fr))" aria-label="Main navigation">
          <a href="/market" aria-current={section === 'market' ? 'page' : undefined}>Fish market</a>
          <a href="/hmi" aria-current={section === 'hmi' ? 'page' : undefined}>Coastal map</a>
        </nav>
      </div></header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><div class="shell"><p>ReelDeal · Miyagi coast</p></div></footer>
    </div>
  </body>
</html>
