PUBLIC_CHAIN_ID=11155111
# Public Reown AppKit project ID used by /app. Allowlist this Astro app's domain in Reown.
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# Routes stay with the existing app until their Astro replacements are ready.
LEGACY_WEB_ORIGIN=http://localhost:3000
# Server-only integration handoffs; the component workshop needs neither.
# PIPELINE_API_URL=http://localhost:8787
# DATABASE_URL=postgresql://...

# Sepolia RPC for /relief, /market/checkout-demo and their API routes (frontend/src/lib/chain). Optional --
# defaults to a public endpoint; override for a private/rate-limited RPC in production.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Co-op signer key for POST /api/market/quote (SaleRouter EIP-712 quotes, docs/SALE-ROUTER.md). Server-only
# secret -- never sent to the client. Copy from the repo root .env's COOP_SIGNER_PRIVATE_KEY. Unset: the
# quote endpoint responds 503 instead of signing with an absent key.
# QUOTE_SIGNER_PRIVATE_KEY=
