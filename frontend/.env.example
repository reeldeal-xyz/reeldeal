PUBLIC_CHAIN_ID=11155111
# Public Reown AppKit project ID used by /app. Allowlist this Astro app's domain in Reown.
# NEXT_PUBLIC_REOWN_PROJECT_ID=
# Routes stay with the existing app until their Astro replacements are ready.
LEGACY_WEB_ORIGIN=http://localhost:3000
# Server-only integration handoffs.
# PIPELINE_API_URL=http://localhost:8787
# DATABASE_URL=postgresql://...

# Sepolia RPC for /relief and its API routes (frontend/src/lib/chain). Optional --
# defaults to a public endpoint; override for a private/rate-limited RPC in production.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Server-only key matching SaleRouter.quoteSigner. Unset: catalogue and receipts remain readable;
# new purchases stay disabled. Never use a PUBLIC_ prefix or place this key in browser code.
# COOP_SIGNER_PRIVATE_KEY=

# Optional server-only commercial Open-Meteo subscription key.
# No key uses the public, noncommercial-only forecast endpoints.
# OPEN_METEO_API_KEY=
