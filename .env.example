# Chain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
BINDER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
PIPELINE_SIGNER_PRIVATE_KEY=
COOP_SIGNER_PRIVATE_KEY=
SCIENCE_KEY_PRIVATE_KEY=
# Set after HumanRegistry deploys to Sepolia (issue #16).
HUMAN_REGISTRY_ADDRESS=

# World ID (developer.world.org)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=bind-payout-wallet
WORLD_ACTION_L2=upgrade-level-2
WORLD_ENVIRONMENT=production

# LINE (developers.line.biz)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LIFF_ID=
LINE_MESSAGING_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Leave empty: lib/line.ts mints a short-lived token via client_credentials instead. Set only to override.
LINE_CHANNEL_ACCESS_TOKEN=

# Session (any random string; signs the LIFF session cookie, issue #13)
SESSION_SECRET=

# Curvegrid MultiBaas
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
MULTIBAAS_WEBHOOK_SECRET=

# Pipeline
PIPELINE_PORT=8787
PIPELINE_FEED_URL=http://localhost:8787

# Web app (issues #19/#20/#21) — public, safe to expose to the browser.
# Leave unset locally: screens render a "not deployed yet" state instead of failing.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_RELIEF_POOL_ADDRESS=
# Block ReliefPool was deployed at (issue #16); bounds the event-log scan for the ledger. Defaults to 0 if unset.
NEXT_PUBLIC_RELIEF_POOL_DEPLOY_BLOCK=
NEXT_PUBLIC_HUMAN_REGISTRY_ADDRESS=
# ENSv2 branch registry for karakuwa.<parent>.eth (issue #7). TODO(#7): fill in once the branch is registered.
NEXT_PUBLIC_ENS_PARENT_REGISTRY_ADDRESS=
# PermissionedResolver proxy the plots/slots use for text/addr records (issue #7). TODO(#7).
NEXT_PUBLIC_ENS_PLOT_RESOLVER_ADDRESS=
# Per-plot UserRegistry template/address the holder screen registers/unregisters slots against (issue #10).
# TODO(#10): #10 deploys one UserRegistry per plot; this single address is a scaffold stand-in until then.
NEXT_PUBLIC_ENS_SLOT_REGISTRY_ADDRESS=
# Set after ReliefPool deploys to Sepolia (issue #16). Enables the on-chain check on /verify/[eventId].
RELIEF_POOL=
