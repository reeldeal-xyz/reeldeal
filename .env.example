# Chain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
BINDER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
PIPELINE_SIGNER_PRIVATE_KEY=
COOP_SIGNER_PRIVATE_KEY=
SCIENCE_KEY_PRIVATE_KEY=
# Set after HumanRegistry deploys to Sepolia (issue #16).
HUMAN_REGISTRY_ADDRESS=
# Set after ReliefPool deploys to Sepolia (issue #16).
RELIEF_POOL_ADDRESS=
# Optional: block ReliefPool was deployed at, so the keeper's Enrolled-event scan (issue #17) doesn't have
# to start from genesis on a public RPC. Unset scans from genesis (fine for anvil/local).
RELIEF_POOL_DEPLOY_BLOCK=

# World ID (developer.world.org)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=bind-payout-wallet
WORLD_ACTION_L2=upgrade-level-2
WORLD_ENVIRONMENT=production

# LINE (developers.line.biz)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LIFF_ID=
LINE_MESSAGING_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Leave empty: lib/line.ts mints a short-lived token via client_credentials instead. Set only to override.
LINE_CHANNEL_ACCESS_TOKEN=

# Session (any random string; signs the LIFF session cookie, issue #13)
SESSION_SECRET=

# Curvegrid MultiBaas
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
MULTIBAAS_WEBHOOK_SECRET=

# Pipeline
PIPELINE_PORT=8787
PIPELINE_FEED_URL=http://localhost:8787

# Keeper (issue #17): bun run keeper -- --event <id> [--dry-run], and POST /api/keeper/replay
# Bearer token for POST /api/keeper/replay.
KEEPER_API_TOKEN=
# JSON-file-backed payout directory (web/src/lib/payout-directory.ts). Optional; default shown.
PAYOUT_DIRECTORY_FILE=.data/payout-directory.json
